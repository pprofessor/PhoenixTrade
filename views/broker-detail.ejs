<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= broker.name %>
    </title>
    <!-- فونت سمیم -->
    <link rel="stylesheet" href="/css/fonts.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Samim', 'Vazir', 'Tahoma', sans-serif;
            background: linear-gradient(165deg, #0a3825 0%, #1a4f33 30%, #2e6b49 60%, #1a4f33 100%);
            min-height: 100vh;
            color: #ffffff;
            line-height: 1.6;
            position: relative;
            overflow-x: hidden;
        }

        body::before {
            content: '';
            position: fixed;
            top: -40%;
            left: -40%;
            width: 180%;
            height: 180%;
            background: radial-gradient(circle at 40% 40%,
                    rgba(255, 255, 255, 0.35) 0%,
                    rgba(100, 230, 170, 0.25) 25%,
                    rgba(40, 120, 80, 0.15) 50%,
                    transparent 80%);
            animation: jadeShimmer 18s ease-in-out infinite;
            pointer-events: none;
            z-index: 0;
        }

        @keyframes jadeShimmer {
            0% {
                transform: rotate(0deg) scale(1);
                opacity: 0.4;
            }

            25% {
                transform: rotate(3deg) scale(1.05);
                opacity: 0.8;
            }

            50% {
                transform: rotate(0deg) scale(1.1);
                opacity: 0.5;
            }

            75% {
                transform: rotate(-3deg) scale(1.05);
                opacity: 0.8;
            }

            100% {
                transform: rotate(0deg) scale(1);
                opacity: 0.4;
            }
        }

        .container {
            max-width: 1300px;
            margin: 0 auto;
            padding: 0 20px;
            position: relative;
            z-index: 10;
        }

        .header {
            position: sticky;
            top: 20px;
            z-index: 100;
            background: rgba(10, 40, 25, 0.25);
            backdrop-filter: blur(20px) saturate(180%);
            border-radius: 60px;
            margin: 20px auto;
            padding: 12px 35px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3),
                0 0 0 1px rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-icon {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, #ffd700, #b8860b);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            color: #0a3825;
            box-shadow: 0 0 25px rgba(255, 215, 0, 0.5);
        }

        .logo-text {
            font-size: 1.7rem;
            font-weight: bold;
            background: linear-gradient(135deg, #ffd700, #ffe68f);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-menu {
            display: flex;
            gap: 25px;
            list-style: none;
            flex-wrap: wrap;
        }

        .nav-menu a {
            text-decoration: none;
            color: #ffffff;
            font-weight: 500;
            transition: all 0.3s;
            padding: 8px 18px;
            border-radius: 40px;
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(5px);
            font-size: 0.95rem;
        }

        .nav-menu a:hover {
            background: rgba(255, 215, 0, 0.25);
            color: #ffd700;
            transform: translateY(-3px);
        }

        .header-actions {
            display: flex;
            gap: 15px;
            align-items: center;
            flex-wrap: wrap;
        }

        .lang-selector {
            display: flex;
            gap: 5px;
            background: rgba(0, 0, 0, 0.25);
            padding: 4px;
            border-radius: 40px;
        }

        .lang-btn {
            padding: 5px 12px;
            border: none;
            background: transparent;
            border-radius: 40px;
            cursor: pointer;
            font-size: 0.85rem;
            transition: all 0.3s;
            color: #ffffff;
        }

        .lang-btn.active {
            background: #ffd700;
            color: #0a3825;
        }

        .telegram-link {
            background: linear-gradient(135deg, #27a7e7, #0f7bc0);
            color: white;
            padding: 8px 20px;
            border-radius: 40px;
            text-decoration: none;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* بخش اصلی */
        .broker-header {
            background: rgba(10, 40, 25, 0.25);
            backdrop-filter: blur(15px) saturate(180%);
            border-radius: 40px;
            padding: 40px;
            margin: 40px 0;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .broker-header-content {
            display: flex;
            gap: 40px;
            align-items: center;
            flex-wrap: wrap;
        }

        .broker-logo {
            width: 120px;
            height: 120px;
            background: linear-gradient(135deg, #ffd700, #b8860b);
            border-radius: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: #0a3825;
            box-shadow: 0 20px 40px rgba(255, 215, 0, 0.3);
        }

        .broker-info {
            flex: 1;
        }

        .broker-name {
            font-size: 2.5rem;
            color: #ffd700;
            margin-bottom: 10px;
        }

        .broker-rating {
            display: flex;
            gap: 5px;
            align-items: center;
            margin-bottom: 20px;
        }

        .stars {
            color: #ffd700;
            font-size: 1.2rem;
        }

        .rating-value {
            color: #fff;
            font-size: 1.1rem;
        }

        .broker-actions {
            display: flex;
            gap: 20px;
        }

        .btn {
            padding: 12px 35px;
            border: none;
            border-radius: 40px;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary {
            background: linear-gradient(135deg, #ffd700, #b8860b);
            color: #0a3825;
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(255, 215, 0, 0.3);
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(5px);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-3px);
        }

        .features-section {
            background: rgba(10, 40, 25, 0.25);
            backdrop-filter: blur(15px) saturate(180%);
            border-radius: 40px;
            padding: 40px;
            margin: 40px 0;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .section-title {
            font-size: 1.8rem;
            color: #ffd700;
            margin-bottom: 30px;
            text-align: center;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 25px;
        }

        .feature-card {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 20px;
            padding: 25px;
            border: 1px solid rgba(255, 215, 0, 0.2);
            transition: all 0.3s;
        }

        .feature-card:hover {
            border-color: #ffd700;
            transform: translateY(-5px);
        }

        .feature-title {
            color: #ffd700;
            font-size: 1.1rem;
            margin-bottom: 10px;
        }

        .feature-value {
            font-size: 1.3rem;
            font-weight: bold;
            color: white;
        }

        .feature-unit {
            color: #aaa;
            font-size: 0.9rem;
            margin-right: 5px;
        }

        .feature-boolean {
            display: inline-block;
            padding: 5px 15px;
            border-radius: 30px;
            background: rgba(40, 167, 69, 0.15);
            color: #28a745;
            border: 1px solid #28a745;
        }

        .feature-boolean.false {
            background: rgba(220, 53, 69, 0.15);
            color: #dc3545;
            border: 1px solid #dc3545;
        }

        .loading {
            text-align: center;
            padding: 100px;
        }

        .loading i {
            font-size: 3rem;
            color: #ffd700;
        }

        .footer {
            background: rgba(0, 20, 10, 0.35);
            backdrop-filter: blur(20px) saturate(180%);
            padding: 60px 0 30px;
            margin-top: 100px;
            border-top: 1px solid rgba(255, 255, 255, 0.15);
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 40px;
        }

        .footer-section h3 {
            color: #ffd700;
            margin-bottom: 20px;
        }

        .footer-section a {
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            display: block;
            margin-bottom: 10px;
        }

        .footer-section a:hover {
            color: #ffd700;
        }

        .copyright {
            text-align: center;
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            color: rgba(255, 255, 255, 0.6);
        }

        @media (max-width: 768px) {
            .broker-header-content {
                flex-direction: column;
                text-align: center;
            }

            .broker-actions {
                justify-content: center;
            }

            .broker-name {
                font-size: 2rem;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <!-- هدر -->
        <header class="header">
            <div class="header-content">
                <a href="/" style="text-decoration: none;">
                    <div class="logo">
                        <div class="logo-icon">🦅</div>
                        <span class="logo-text">ققنوس</span>
                    </div>
                </a>

                <ul class="nav-menu">
                    <li><a href="/">صفحه اصلی</a></li>
                    <li><a href="/brokers">بروکرها</a></li>
                    <li><a href="/education">آموزش</a></li>
                    <li><a href="/markets">بازارها</a></li>
                    <li><a href="/contact">ارتباط با ما</a></li>
                </ul>

                <div class="header-actions">
                    <div class="lang-selector">
                        <button class="lang-btn active" data-lang="fa">FA</button>
                        <button class="lang-btn" data-lang="en">EN</button>
                        <button class="lang-btn" data-lang="ar">AR</button>
                    </div>

                    <a href="https://t.me/PhoenixTradeBot" class="telegram-link" target="_blank">
                        <i class="fab fa-telegram-plane"></i>
                        کانال تلگرام
                    </a>
                </div>
            </div>
        </header>

        <!-- محتوای اصلی -->
        <div id="broker-container">
            <div class="loading">
                <i class="fas fa-spinner fa-spin"></i>
                <p style="margin-top: 20px;">در حال بارگذاری اطلاعات بروکر...</p>
            </div>
        </div>
    </div>

    <!-- فوتر -->
    <%- include('footer') %>

    <script>
        const slug = window.location.pathname.split('/').pop();

        function compareSingleBroker(id) {
            window.location.href = `/compare?ids=${id}`;
        }

        function loadBrokerDetails() {
            fetch(`/api/brokers/${slug}`)
                .then(res => res.json())
                .then(result => {
                    if (result.success) {
                        displayBroker(result.data);
                    } else {
                        showError();
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showError();
                });
        }

        function displayBroker(broker) {
            const stars = '★'.repeat(Math.floor(broker.rating)) + '☆'.repeat(5 - Math.floor(broker.rating));

            // ویژگی‌های اصلی بروکر از خود مدل Broker
            const features = [
                { title: 'سال تأسیس', value: broker.foundedYear || '-' },
                { title: 'تعداد کاربران', value: broker.usersCount || '۰' },
                { title: 'اسپرد', value: broker.spread || '-' },
                { title: 'حداکثر لوریج', value: broker.leverage || '-' },
                { title: 'حداقل سپرده', value: broker.minDeposit || '-' }
            ];

            let featuresHtml = `
        <div class="features-section">
            <h2 class="section-title">ویژگی‌های بروکر</h2>
            <div class="features-grid">
    `;

            features.forEach(f => {
                featuresHtml += `
            <div class="feature-card">
                <div class="feature-title">${f.title}</div>
                <div class="feature-value">${f.value}</div>
            </div>
        `;
            });

            featuresHtml += `</div></div>`;

            const html = `
        <div class="broker-header">
            <div class="broker-header-content">
                <div class="broker-logo">
                    ${broker.logo ? `<img src="${broker.logo}" style="width:100%; height:100%; object-fit:cover;">` : '📊'}
                </div>
                <div class="broker-info">
                    <h1 class="broker-name">${broker.display_name_fa || broker.name}</h1>
                    <div class="broker-rating">
                        <span class="stars">${stars}</span>
                        <span class="rating-value">(${broker.rating})</span>
                    </div>
                    <div class="broker-actions">
                        <a href="${broker.registerLink || '#'}" class="btn btn-primary" target="_blank">
                            ثبت‌نام و دریافت جایزه
                        </a>
                        <a href="/compare?ids=${broker.id}" class="btn btn-secondary" onclick="event.preventDefault(); compareSingleBroker(${broker.id})">                            مقایسه با دیگران
                        </a>
                    </div>
                </div>
            </div>
        </div>
        ${featuresHtml}
    `;

            document.getElementById('broker-container').innerHTML = html;
        }
        function showError() {
            document.getElementById('broker-container').innerHTML = `
                <div class="features-section" style="text-align: center; padding: 100px;">
                    <i class="fas fa-exclamation-triangle" style="font-size: 3rem; color: #dc3545;"></i>
                    <p style="margin-top: 20px; color: #dc3545;">خطا در بارگذاری اطلاعات بروکر</p>
                    <a href="/brokers" style="display: inline-block; margin-top: 20px; padding: 10px 30px; background: #ffd700; color: #0a3825; text-decoration: none; border-radius: 30px;">بازگشت به لیست بروکرها</a>
                </div>
            `;
        }

        document.addEventListener('DOMContentLoaded', loadBrokerDetails);
    </script>

</body>

</html>