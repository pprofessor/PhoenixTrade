<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title data-fa="<%= broker.name %> - بررسی تخصصی | PhoenixTrade"
        data-en="<%= broker.name %> - Professional Review | PhoenixTrade"
        data-ar="<%= broker.name %> - مراجعة احترافية | PhoenixTrade">
        <%= broker.name %> - بررسی تخصصی | PhoenixTrade
    </title>
    <!-- فونت سمیم -->
    <link rel="stylesheet" href="/css/fonts.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Samim', 'Vazir', 'Tahoma', sans-serif;
            background: linear-gradient(165deg, #0a3825 0%, #1a4f33 30%, #2e6b49 60%, #1a4f33 100%);
            min-height: 100vh;
            color: #ffffff;
            line-height: 1.6;
            position: relative;
            overflow-x: hidden;
        }

        body::before {
            content: '';
            position: fixed;
            top: -40%;
            left: -40%;
            width: 180%;
            height: 180%;
            background: radial-gradient(circle at 40% 40%,
                    rgba(255, 255, 255, 0.35) 0%,
                    rgba(100, 230, 170, 0.25) 25%,
                    rgba(40, 120, 80, 0.15) 50%,
                    transparent 80%);
            animation: jadeShimmer 18s ease-in-out infinite;
            pointer-events: none;
            z-index: 0;
        }

        @keyframes jadeShimmer {
            0% {
                transform: rotate(0deg) scale(1);
                opacity: 0.4;
            }

            25% {
                transform: rotate(3deg) scale(1.05);
                opacity: 0.8;
            }

            50% {
                transform: rotate(0deg) scale(1.1);
                opacity: 0.5;
            }

            75% {
                transform: rotate(-3deg) scale(1.05);
                opacity: 0.8;
            }

            100% {
                transform: rotate(0deg) scale(1);
                opacity: 0.4;
            }
        }

        .container {
            max-width: 1300px;
            margin: 0 auto;
            padding: 0 20px;
            position: relative;
            z-index: 10;
        }

        /* بخش اصلی */
        .broker-header {
            background: rgba(10, 40, 25, 0.25);
            backdrop-filter: blur(15px) saturate(180%);
            border-radius: 40px;
            padding: 40px;
            margin: 40px 0;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .broker-header-content {
            display: flex;
            gap: 40px;
            align-items: center;
            flex-wrap: wrap;
        }

        .broker-logo {
            width: 120px;
            height: 120px;
            background: linear-gradient(135deg, #ffd700, #b8860b);
            border-radius: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: #0a3825;
            box-shadow: 0 20px 40px rgba(255, 215, 0, 0.3);
            overflow: hidden;
        }

        .broker-logo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .broker-info {
            flex: 1;
        }

        .broker-name {
            font-size: 2.5rem;
            color: #ffd700;
            margin-bottom: 10px;
        }

        .broker-rating {
            display: flex;
            gap: 5px;
            align-items: center;
            margin-bottom: 20px;
        }

        .stars {
            color: #ffd700;
            font-size: 1.2rem;
        }

        .rating-value {
            color: #fff;
            font-size: 1.1rem;
        }

        .broker-actions {
            display: flex;
            gap: 20px;
        }

        .btn {
            padding: 12px 35px;
            border: none;
            border-radius: 40px;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary {
            background: linear-gradient(135deg, #ffd700, #b8860b);
            color: #0a3825;
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(255, 215, 0, 0.3);
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(5px);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-3px);
        }

        .features-section {
            background: rgba(10, 40, 25, 0.25);
            backdrop-filter: blur(15px) saturate(180%);
            border-radius: 40px;
            padding: 40px;
            margin: 40px 0;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .section-title {
            font-size: 1.8rem;
            color: #ffd700;
            margin-bottom: 30px;
            text-align: center;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 25px;
        }

        .feature-card {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 20px;
            padding: 25px;
            border: 1px solid rgba(255, 215, 0, 0.2);
            transition: all 0.3s;
        }

        .feature-card:hover {
            border-color: #ffd700;
            transform: translateY(-5px);
        }

        .feature-title {
            color: #ffd700;
            font-size: 1.1rem;
            margin-bottom: 10px;
        }

        .feature-value {
            font-size: 1.3rem;
            font-weight: bold;
            color: white;
        }

        .feature-unit {
            color: #aaa;
            font-size: 0.9rem;
            margin-right: 5px;
        }

        .feature-boolean {
            display: inline-block;
            padding: 5px 15px;
            border-radius: 30px;
            background: rgba(40, 167, 69, 0.15);
            color: #28a745;
            border: 1px solid #28a745;
        }

        .feature-boolean.false {
            background: rgba(220, 53, 69, 0.15);
            color: #dc3545;
            border: 1px solid #dc3545;
        }

        .loading {
            text-align: center;
            padding: 100px;
        }

        .loading i {
            font-size: 3rem;
            color: #ffd700;
        }

        .error-message {
            text-align: center;
            padding: 100px;
            color: #dc3545;
        }

        @media (max-width: 768px) {
            .broker-header-content {
                flex-direction: column;
                text-align: center;
            }

            .broker-actions {
                justify-content: center;
            }

            .broker-name {
                font-size: 2rem;
            }
        }
    </style>

    <script src="/js/i18n.js"></script>
</head>

<body>
    <div class="container">
        <!-- هدر -->
        <%- include('header') %>

            <!-- محتوای اصلی -->
            <div id="broker-container">
                <div class="loading">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p style="margin-top: 20px;" data-fa="در حال بارگذاری اطلاعات بروکر..."
                        data-en="Loading broker information..." data-ar="جاري تحميل معلومات الوسيط...">در حال بارگذاری
                        اطلاعات بروکر...</p>
                </div>
            </div>
    </div>

    <!-- فوتر -->
    <%- include('footer') %>

        <script>
            const slug = window.location.pathname.split('/').pop();
            let currentBroker = null;

            function compareSingleBroker(id) {
                window.location.href = `/compare?ids=${id}`;
            }

            function loadBrokerDetails() {
                fetch(`/api/brokers/${slug}`)
                    .then(res => res.json())
                    .then(result => {
                        if (result.success) {
                            currentBroker = result.data;
                            displayBroker(currentBroker);
                        } else {
                            showError();
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showError();
                    });
            }

            function displayBroker(broker) {
                const currentLang = window.currentLang || 'fa';
                const stars = '★'.repeat(Math.floor(broker.rating)) + '☆'.repeat(5 - Math.floor(broker.rating));

                // عنوان‌های ویژگی‌ها بر اساس زبان
                const featureTitles = {
                    foundedYear: {
                        fa: 'سال تأسیس',
                        en: 'Founded',
                        ar: 'تأسس'
                    },
                    usersCount: {
                        fa: 'تعداد کاربران',
                        en: 'Users',
                        ar: 'المستخدمين'
                    },
                    spread: {
                        fa: 'اسپرد',
                        en: 'Spread',
                        ar: 'السبريد'
                    },
                    leverage: {
                        fa: 'حداکثر لوریج',
                        en: 'Max Leverage',
                        ar: 'الرافعة القصوى'
                    },
                    minDeposit: {
                        fa: 'حداقل سپرده',
                        en: 'Min Deposit',
                        ar: 'الحد الأدنى للإيداع'
                    }
                };

                // ویژگی‌های اصلی بروکر
                const features = [
                    { key: 'foundedYear', value: broker.foundedYear || '-' },
                    { key: 'usersCount', value: broker.usersCount || '۰' },
                    { key: 'spread', value: broker.spread || '-' },
                    { key: 'leverage', value: broker.leverage || '-' },
                    { key: 'minDeposit', value: broker.minDeposit || '-' }
                ];

                let featuresHtml = `
                <div class="features-section">
                    <h2 class="section-title" data-fa="ویژگی‌های بروکر" 
                        data-en="Broker Features" 
                        data-ar="ميزات الوسيط">ویژگی‌های بروکر</h2>
                    <div class="features-grid">
            `;

                features.forEach(f => {
                    const title = featureTitles[f.key][currentLang] || featureTitles[f.key].fa;
                    featuresHtml += `
                    <div class="feature-card">
                        <div class="feature-title">${title}</div>
                        <div class="feature-value">${f.value}</div>
                    </div>
                `;
                });

                featuresHtml += `</div></div>`;

                // انتخاب نام بروکر بر اساس زبان
                let brokerName = broker.display_name_fa || broker.name;
                if (currentLang === 'en' && broker.display_name_en) {
                    brokerName = broker.display_name_en;
                } else if (currentLang === 'ar' && broker.display_name_ar) {
                    brokerName = broker.display_name_ar;
                }

                const html = `
                <div class="broker-header">
                    <div class="broker-header-content">
                        <div class="broker-logo">
                            ${broker.logo ? `<img src="${broker.logo}" style="width:100%; height:100%; object-fit:cover;">` : '📊'}
                        </div>
                        <div class="broker-info">
                            <h1 class="broker-name">${brokerName}</h1>
                            <div class="broker-rating">
                                <span class="stars">${stars}</span>
                                <span class="rating-value">(${broker.rating})</span>
                            </div>
                            <div class="broker-actions">
                                <a href="${broker.registerLink || '#'}" class="btn btn-primary" target="_blank"
                                   data-fa="ثبت‌نام و دریافت جایزه" 
                                   data-en="Register & Get Bonus" 
                                   data-ar="سجل واحصل على مكافأة">
                                    ثبت‌نام و دریافت جایزه
                                </a>
                                <a href="/compare?ids=${broker.id}" class="btn btn-secondary" 
                                   onclick="event.preventDefault(); compareSingleBroker(${broker.id})"
                                   data-fa="مقایسه با دیگران" 
                                   data-en="Compare with Others" 
                                   data-ar="قارن مع الآخرين">
                                    مقایسه با دیگران
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                ${featuresHtml}
            `;

                document.getElementById('broker-container').innerHTML = html;
            }

            function showError() {
                const currentLang = window.currentLang || 'fa';
                const errorMsg = currentLang === 'fa' ? 'خطا در بارگذاری اطلاعات بروکر' :
                    currentLang === 'en' ? 'Error loading broker information' :
                        'خطأ في تحميل معلومات الوسيط';

                const backText = currentLang === 'fa' ? 'بازگشت به لیست بروکرها' :
                    currentLang === 'en' ? 'Back to Brokers List' :
                        'العودة إلى قائمة الوسطاء';

                document.getElementById('broker-container').innerHTML = `
                <div class="features-section" style="text-align: center; padding: 100px;">
                    <i class="fas fa-exclamation-triangle" style="font-size: 3rem; color: #dc3545;"></i>
                    <p style="margin-top: 20px; color: #dc3545;">${errorMsg}</p>
                    <a href="/brokers" style="display: inline-block; margin-top: 20px; padding: 10px 30px; background: #ffd700; color: #0a3825; text-decoration: none; border-radius: 30px;">${backText}</a>
                </div>
            `;
            }

            // گوش دادن به رویداد تغییر زبان
            document.addEventListener('languageChanged', function (e) {
                if (currentBroker) {
                    displayBroker(currentBroker);
                }
            });

            document.addEventListener('DOMContentLoaded', loadBrokerDetails);
        </script>
</body>

</html>