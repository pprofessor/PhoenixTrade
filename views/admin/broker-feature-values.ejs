<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تنظیم ویژگی‌های <%= broker.name %> - PhoenixTrade</title>
    <!-- فونت سمیم -->
    <link rel="stylesheet" href="/css/fonts.css">
    <!-- استایل سراسری پنل -->
    <link rel="stylesheet" href="/css/admin.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .feature-group {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 30px;
            border: 1px solid rgba(255, 215, 0, 0.2);
        }

        .feature-group h3 {
            color: #ffd700;
            margin-bottom: 20px;
            font-size: 1.2rem;
            border-bottom: 1px solid rgba(255, 215, 0, 0.3);
            padding-bottom: 10px;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
        }

        .feature-item {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 10px;
            padding: 15px;
            border: 1px solid rgba(255, 215, 0, 0.1);
        }

        .feature-item label {
            display: block;
            color: #ffd700;
            margin-bottom: 8px;
            font-weight: 500;
        }

        .feature-item small {
            display: block;
            color: #aaa;
            font-size: 0.8rem;
            margin-top: 5px;
        }

        .unit-badge {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 12px;
            background: rgba(255, 215, 0, 0.1);
            color: #ffd700;
            font-size: 0.75rem;
            margin-right: 5px;
        }

        .btn-group {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .back-link {
            display: inline-block;
            margin-bottom: 20px;
            color: #ffd700;
            text-decoration: none;
        }

        .back-link:hover {
            text-decoration: underline;
        }
    </style>
</head>

<body>
    <%- include('../sidebar', { activePage: 'brokers' }) %>

        <div class="main-content">
            <div class="header">
                <h1><i class="fas fa-sliders-h"></i> تنظیم ویژگی‌های <%= broker.name %>
                </h1>
            </div>

            <a href="/pprofessor/brokers" class="back-link">
                <i class="fas fa-arrow-right"></i> بازگشت به لیست بروکرها
            </a>

            <form id="features-form" onsubmit="event.preventDefault(); saveFeatures();">
                <% const categories={ general: 'ویژگی‌های عمومی' , trading: 'ویژگی‌های معاملاتی' ,
                    account: 'ویژگی‌های حساب' , support: 'پشتیبانی' }; for (const [catKey, catTitle] of
                    Object.entries(categories)) { const catFeatures=features.filter(f=> f.category === catKey);
                    if (catFeatures.length > 0) {
                    %>
                    <div class="feature-group">
                        <h3>
                            <%= catTitle %>
                        </h3>
                        <div class="features-grid">
                            <% catFeatures.forEach(feature=> {
                                const value = featureValues[feature.id] || '';
                                %>
                                <div class="feature-item">
                                    <label>
                                        <%= feature.title_fa %>
                                            <% if (feature.unit) { %>
                                                <span class="unit-badge">
                                                    <%= feature.unit %>
                                                </span>
                                                <% } %>
                                    </label>

                                    <% if (feature.dataType==='boolean' ) { %>
                                        <select class="form-control" id="feature-<%= feature.id %>"
                                            name="feature-<%= feature.id %>">
                                            <option value="true" <%=value==='true' ? 'selected' : '' %>>بله</option>
                                            <option value="false" <%=value==='false' || !value ? 'selected' : '' %>>خیر
                                            </option>
                                        </select>
                                        <% } else if (feature.dataType==='number' ) { %>
                                            <input type="number" class="form-control" id="feature-<%= feature.id %>"
                                                name="feature-<%= feature.id %>" value="<%= value %>" step="any">
                                            <% } else if (feature.dataType==='rating' ) { %>
                                                <input type="number" class="form-control" id="feature-<%= feature.id %>"
                                                    name="feature-<%= feature.id %>" value="<%= value %>" min="0"
                                                    max="5" step="0.1">
                                                <% } else { %>
                                                    <input type="text" class="form-control"
                                                        id="feature-<%= feature.id %>" name="feature-<%= feature.id %>"
                                                        value="<%= value %>">
                                                    <% } %>

                                                        <small>
                                                            <%= feature.title_en %> / <%= feature.title_ar %>
                                                        </small>
                                </div>
                                <% }) %>
                        </div>
                    </div>
                    <% }} %>

                        <div class="btn-group">
                            <button type="submit" class="btn">ذخیره ویژگی‌ها</button>
                            <a href="/pprofessor/brokers" class="btn btn-danger">انصراف</a>
                        </div>
            </form>
        </div>

        <script>
            function saveFeatures() {
                const form = document.getElementById('features-form');
                const formData = new FormData(form);
                const features = [];

                for (let [key, value] of formData.entries()) {
                    if (key.startsWith('feature-')) {
                        const featureId = key.replace('feature-', '');
                        features.push({
                            featureId: parseInt(featureId),
                            value: value
                        });
                    }
                }

                fetch(`/pprofessor/api/brokers/<%= broker.id %>/features`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ features })
                })
                    .then(res => res.json())
                    .then(result => {
                        if (result.success) {
                            alert('ویژگی‌ها با موفقیت ذخیره شدند');
                            window.location.href = '/pprofessor/brokers';
                        } else {
                            alert('خطا: ' + result.error);
                        }
                    });
            }
        </script>
</body>

</html>