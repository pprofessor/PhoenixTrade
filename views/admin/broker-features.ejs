<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - PhoenixTrade
    </title>
    <!-- فونت سمیم -->
    <link rel="stylesheet" href="/css/fonts.css">
    <!-- استایل سراسری پنل -->
    <link rel="stylesheet" href="/css/admin.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .category-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 500;
        }

        .category-general {
            background: rgba(23, 162, 184, 0.15);
            color: #17a2b8;
            border: 1px solid #17a2b8;
        }

        .category-trading {
            background: rgba(40, 167, 69, 0.15);
            color: #28a745;
            border: 1px solid #28a745;
        }

        .category-account {
            background: rgba(255, 193, 7, 0.15);
            color: #ffc107;
            border: 1px solid #ffc107;
        }

        .category-support {
            background: rgba(153, 102, 255, 0.15);
            color: #9966ff;
            border: 1px solid #9966ff;
        }

        .data-type-badge {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 0.75rem;
            background: rgba(255, 215, 0, 0.1);
            color: #ffd700;
            border: 1px solid #ffd700;
        }

        .status-badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 0.75rem;
        }

        .status-yes {
            background: rgba(40, 167, 69, 0.15);
            color: #28a745;
            border: 1px solid #28a745;
        }

        .status-no {
            background: rgba(220, 53, 69, 0.15);
            color: #dc3545;
            border: 1px solid #dc3545;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: #1a2f2a;
            border-radius: 15px;
            padding: 30px;
            max-width: 600px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            border: 1px solid #ffd700;
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            color: #ffd700;
            font-size: 1.3rem;
            border-bottom: 1px solid rgba(255, 215, 0, 0.3);
            padding-bottom: 10px;
        }

        .modal-close {
            cursor: pointer;
            font-size: 1.8rem;
        }

        .modal-close:hover {
            color: #fff;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            color: #ffd700;
            margin-bottom: 5px;
        }

        .form-control {
            width: 100%;
            padding: 8px 12px;
            border-radius: 5px;
            border: 1px solid rgba(255, 215, 0, 0.3);
            background: rgba(0, 0, 0, 0.3);
            color: #fff;
        }

        .form-control:focus {
            outline: none;
            border-color: #ffd700;
        }

        .checkbox-group {
            display: flex;
            gap: 20px;
            padding: 10px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 8px;
        }

        .checkbox-group label {
            display: flex;
            align-items: center;
            gap: 5px;
            color: #fff;
            cursor: pointer;
        }

        .checkbox-group input[type="checkbox"] {
            accent-color: #ffd700;
        }

        .language-inputs {
            background: rgba(255, 255, 255, 0.03);
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 20px;
            border: 1px solid rgba(255, 215, 0, 0.2);
        }

        .language-title {
            color: #ffd700;
            margin-bottom: 10px;
            font-size: 0.95rem;
        }
    </style>
</head>

<body>
    <%- include('../sidebar', { activePage: 'broker-features' }) %>

        <div class="main-content">
            <div class="header">
                <h1><i class="fas fa-list"></i>
                    <%= title %>
                </h1>
            </div>

            <div style="margin-bottom: 20px;">
                <button class="btn" onclick="showFeatureModal()">
                    <i class="fas fa-plus"></i> ویژگی جدید
                </button>
            </div>

            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>کلید</th>
                            <th>عنوان فارسی</th>
                            <th>نوع داده</th>
                            <th>دسته‌بندی</th>
                            <th>واحد</th>
                            <th>نمایش در مقایسه</th>
                            <th>قابل فیلتر</th>
                            <th>ترتیب</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody id="features-list">
                        <tr>
                            <td colspan="9" style="text-align:center;">در حال بارگذاری...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- مودال ایجاد/ویرایش ویژگی -->
        <div class="modal" id="feature-modal">
            <div class="modal-content">
                <div class="modal-header">
                    <span id="modal-title">ایجاد ویژگی جدید</span>
                    <span class="modal-close" onclick="closeModal()">&times;</span>
                </div>

                <form id="feature-form" onsubmit="event.preventDefault(); saveFeature();">
                    <input type="hidden" id="feature-id">

                    <div class="form-group">
                        <label>کلید ویژگی (key)</label>
                        <input type="text" id="feature-key" class="form-control" required
                            placeholder="مثال: spread, leverage, minDeposit">
                        <small style="color:#aaa;">یکتا و بدون فاصله (حروف انگلیسی)</small>
                    </div>

                    <div class="language-inputs">
                        <div class="language-title"><i class="fas fa-flag"></i> عنوان ویژگی به زبان‌های مختلف</div>
                        <div class="form-group">
                            <label>عنوان فارسی</label>
                            <input type="text" id="feature-title-fa" class="form-control" required placeholder="اسپرد">
                        </div>
                        <div class="form-group">
                            <label>عنوان انگلیسی</label>
                            <input type="text" id="feature-title-en" class="form-control" required placeholder="Spread">
                        </div>
                        <div class="form-group">
                            <label>عنوان عربی</label>
                            <input type="text" id="feature-title-ar" class="form-control" required
                                placeholder="السبريد">
                        </div>
                    </div>

                    <div class="row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                        <div class="form-group">
                            <label>نوع داده</label>
                            <select id="feature-data-type" class="form-control" required>
                                <option value="text">متن (Text)</option>
                                <option value="number">عدد (Number)</option>
                                <option value="boolean">بله/خیر (Boolean)</option>
                                <option value="rating">امتیاز (Rating)</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>دسته‌بندی</label>
                            <select id="feature-category" class="form-control" required>
                                <option value="general">عمومی</option>
                                <option value="trading">معاملاتی</option>
                                <option value="account">حساب</option>
                                <option value="support">پشتیبانی</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>واحد (برای اعداد)</label>
                        <input type="text" id="feature-unit" class="form-control" placeholder="مثال: pip, $, %">
                    </div>

                    <div class="row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                        <div class="form-group">
                            <label>ترتیب نمایش</label>
                            <input type="number" id="feature-order" class="form-control" value="0">
                        </div>
                    </div>

                    <div class="checkbox-group">
                        <label>
                            <input type="checkbox" id="feature-show-comparison" checked>
                            نمایش در مقایسه
                        </label>
                        <label>
                            <input type="checkbox" id="feature-filterable">
                            قابل فیلتر
                        </label>
                    </div>

                    <div style="display: flex; gap: 10px; margin-top: 20px;">
                        <button type="submit" class="btn">ذخیره</button>
                        <button type="button" class="btn btn-danger" onclick="closeModal()">انصراف</button>
                    </div>
                </form>
            </div>
        </div>

        <script>
            function loadFeatures() {
                fetch('/pprofessor/api/broker-features')
                    .then(res => res.json())
                    .then(result => {
                        if (result.success) {
                            let html = '';
                            result.data.forEach(feature => {
                                let categoryClass = {
                                    general: 'category-general',
                                    trading: 'category-trading',
                                    account: 'category-account',
                                    support: 'category-support'
                                }[feature.category] || '';

                                let categoryText = {
                                    general: 'عمومی',
                                    trading: 'معاملاتی',
                                    account: 'حساب',
                                    support: 'پشتیبانی'
                                }[feature.category] || feature.category;

                                let dataTypeText = {
                                    text: 'متن',
                                    number: 'عدد',
                                    boolean: 'بله/خیر',
                                    rating: 'امتیاز'
                                }[feature.dataType] || feature.dataType;

                                html += `<tr>
                                <td><code>${feature.key}</code></td>
                                <td>${feature.title_fa}</td>
                                <td><span class="data-type-badge">${dataTypeText}</span></td>
                                <td><span class="category-badge ${categoryClass}">${categoryText}</span></td>
                                <td>${feature.unit || '-'}</td>
                                <td><span class="status-badge ${feature.showInComparison ? 'status-yes' : 'status-no'}">${feature.showInComparison ? 'بله' : 'خیر'}</span></td>
                                <td><span class="status-badge ${feature.filterable ? 'status-yes' : 'status-no'}">${feature.filterable ? 'بله' : 'خیر'}</span></td>
                                <td>${feature.displayOrder || 0}</td>
                                <td>
                                    <button class="btn-icon" onclick="editFeature(${feature.id})"><i class="fas fa-edit"></i></button>
                                    <button class="btn-icon danger" onclick="deleteFeature(${feature.id})"><i class="fas fa-trash"></i></button>
                                </td>
                            </tr>`;
                            });
                            document.getElementById('features-list').innerHTML = html;
                        }
                    })
                    .catch(error => {
                        document.getElementById('features-list').innerHTML =
                            '<tr><td colspan="9" style="text-align:center; color:#dc3545;">خطا در بارگذاری</td></tr>';
                    });
            }

            function showFeatureModal() {
                document.getElementById('modal-title').textContent = 'ایجاد ویژگی جدید';
                document.getElementById('feature-id').value = '';
                document.getElementById('feature-key').value = '';
                document.getElementById('feature-title-fa').value = '';
                document.getElementById('feature-title-en').value = '';
                document.getElementById('feature-title-ar').value = '';
                document.getElementById('feature-data-type').value = 'text';
                document.getElementById('feature-category').value = 'general';
                document.getElementById('feature-unit').value = '';
                document.getElementById('feature-order').value = '0';
                document.getElementById('feature-show-comparison').checked = true;
                document.getElementById('feature-filterable').checked = false;
                document.getElementById('feature-modal').classList.add('active');
            }

            function editFeature(id) {
                fetch(`/pprofessor/api/broker-features/${id}`)
                    .then(res => res.json())
                    .then(result => {
                        if (result.success) {
                            const feature = result.data;
                            document.getElementById('modal-title').textContent = 'ویرایش ویژگی';
                            document.getElementById('feature-id').value = feature.id;
                            document.getElementById('feature-key').value = feature.key || '';
                            document.getElementById('feature-title-fa').value = feature.title_fa || '';
                            document.getElementById('feature-title-en').value = feature.title_en || '';
                            document.getElementById('feature-title-ar').value = feature.title_ar || '';
                            document.getElementById('feature-data-type').value = feature.dataType || 'text';
                            document.getElementById('feature-category').value = feature.category || 'general';
                            document.getElementById('feature-unit').value = feature.unit || '';
                            document.getElementById('feature-order').value = feature.displayOrder || '0';
                            document.getElementById('feature-show-comparison').checked = feature.showInComparison;
                            document.getElementById('feature-filterable').checked = feature.filterable;
                            document.getElementById('feature-modal').classList.add('active');
                        }
                    });
            }

            function saveFeature() {
                const data = {
                    key: document.getElementById('feature-key').value,
                    title_fa: document.getElementById('feature-title-fa').value,
                    title_en: document.getElementById('feature-title-en').value,
                    title_ar: document.getElementById('feature-title-ar').value,
                    dataType: document.getElementById('feature-data-type').value,
                    category: document.getElementById('feature-category').value,
                    unit: document.getElementById('feature-unit').value,
                    displayOrder: parseInt(document.getElementById('feature-order').value) || 0,
                    showInComparison: document.getElementById('feature-show-comparison').checked,
                    filterable: document.getElementById('feature-filterable').checked
                };

                const id = document.getElementById('feature-id').value;
                const url = id ? `/pprofessor/api/broker-features/${id}` : '/pprofessor/api/broker-features';
                const method = id ? 'PUT' : 'POST';

                fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                })
                    .then(res => res.json())
                    .then(result => {
                        if (result.success) {
                            alert(id ? 'ویژگی ویرایش شد' : 'ویژگی ایجاد شد');
                            closeModal();
                            loadFeatures();
                        } else {
                            alert('خطا: ' + result.error);
                        }
                    });
            }

            function deleteFeature(id) {
                if (confirm('آیا از حذف این ویژگی اطمینان دارید؟ با حذف آن، مقادیر مرتبط نیز حذف می‌شوند.')) {
                    fetch(`/pprofessor/api/broker-features/${id}`, { method: 'DELETE' })
                        .then(res => res.json())
                        .then(result => {
                            if (result.success) {
                                loadFeatures();
                            } else {
                                alert('خطا: ' + result.error);
                            }
                        });
                }
            }

            function closeModal() {
                document.getElementById('feature-modal').classList.remove('active');
            }

            document.addEventListener('DOMContentLoaded', loadFeatures);
        </script>
</body>

</html>