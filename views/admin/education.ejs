<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - PhoenixTrade
    </title>
    <!-- فونت سمیم -->
    <link rel="stylesheet" href="/css/fonts.css">
    <!-- استایل سراسری پنل -->
    <link rel="stylesheet" href="/css/admin.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* استایل‌های اختصاصی صفحه محتوای آموزشی */
        .category-badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 500;
        }

        .category-basic {
            background: rgba(23, 162, 184, 0.15);
            color: #17a2b8;
            border: 1px solid #17a2b8;
        }

        .category-strategy {
            background: rgba(153, 102, 255, 0.15);
            color: #9966ff;
            border: 1px solid #9966ff;
        }

        .category-technical {
            background: rgba(255, 193, 7, 0.15);
            color: #ffc107;
            border: 1px solid #ffc107;
        }

        .category-fundamental {
            background: rgba(40, 167, 69, 0.15);
            color: #28a745;
            border: 1px solid #28a745;
        }

        .status-badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .status-active {
            background: rgba(40, 167, 69, 0.15);
            color: #28a745;
            border: 1px solid #28a745;
        }

        .status-inactive {
            background: rgba(220, 53, 69, 0.15);
            color: #dc3545;
            border: 1px solid #dc3545;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: #1a2f2a;
            border-radius: 15px;
            padding: 30px;
            max-width: 900px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            border: 1px solid #ffd700;
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            color: #ffd700;
        }

        .modal-close {
            cursor: pointer;
            font-size: 1.5rem;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            color: #ffd700;
            margin-bottom: 5px;
        }

        .form-control {
            width: 100%;
            padding: 8px 12px;
            border-radius: 5px;
            border: 1px solid rgba(255, 215, 0, 0.3);
            background: rgba(0, 0, 0, 0.3);
            color: #fff;
        }

        .form-control:focus {
            outline: none;
            border-color: #ffd700;
        }

        textarea.form-control {
            resize: vertical;
            min-height: 100px;
        }

        .btn {
            padding: 8px 20px;
            border-radius: 5px;
            border: none;
            background: linear-gradient(135deg, #ffd700, #b8860b);
            color: #0a2f1f;
            cursor: pointer;
            font-weight: bold;
        }

        .btn-danger {
            background: linear-gradient(135deg, #dc3545, #a71d2a);
            color: white;
        }

        .btn-sm {
            padding: 5px 10px;
            font-size: 0.9rem;
        }

        .btn-icon {
            padding: 5px 10px;
            border-radius: 5px;
            background: transparent;
            border: 1px solid rgba(255, 215, 0, 0.3);
            color: #ffd700;
            cursor: pointer;
            margin: 0 3px;
        }

        .btn-icon:hover {
            background: #ffd700;
            color: #0a2f1f;
        }

        .btn-icon.danger:hover {
            background: #dc3545;
            color: white;
            border-color: #dc3545;
        }

        .language-section {
            background: rgba(255, 255, 255, 0.03);
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 20px;
            border: 1px solid rgba(255, 215, 0, 0.2);
        }

        .language-title {
            color: #ffd700;
            font-size: 1rem;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        code {
            background: rgba(0, 0, 0, 0.3);
            padding: 2px 5px;
            border-radius: 3px;
            color: #ffd700;
        }
    </style>

    <script src="/js/i18n.js"></script></head>

<body>
    <!-- سایدبار -->
    <%- include('../sidebar', { activePage: 'education' }) %>

        <div class="main-content">
            <div class="header">
                <h1><i class="fas fa-graduation-cap"></i>
                    <%= title %>
                </h1>
            </div>

            <!-- دکمه ایجاد محتوای جدید -->
            <div style="margin-bottom: 20px;">
                <button class="btn" onclick="showContentModal()">
                    <i class="fas fa-plus"></i> محتوای جدید
                </button>
            </div>

            <!-- جدول محتوا -->
            <div class="table-container" style="overflow-x: auto;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>عنوان فارسی</th>
                            <th>slug</th>
                            <th>دسته‌بندی</th>
                            <th>بازدید</th>
                            <th>ترتیب</th>
                            <th>وضعیت</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody id="contents-list">
                        <tr>
                            <td colspan="7" style="text-align:center;">در حال بارگذاری...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- مودال ایجاد/ویرایش محتوا -->
        <div class="modal" id="content-modal">
            <div class="modal-content">
                <div class="modal-header">
                    <span id="modal-title">ایجاد محتوای جدید</span>
                    <span class="modal-close" onclick="closeModal()">&times;</span>
                </div>

                <form id="content-form" onsubmit="event.preventDefault(); saveContent();">
                    <input type="hidden" id="content-id">

                    <!-- اطلاعات پایه -->
                    <div style="margin-bottom: 20px;">
                        <div class="row">
                            <div class="form-group">
                                <label>عنوان (برای slug)</label>
                                <input type="text" id="content-title" class="form-control" required>
                                <small style="color:#aaa;">مثال: مقدمه‌ای بر فارکس</small>
                            </div>

                            <div class="form-group">
                                <label>slug (آدرس یکتا)</label>
                                <input type="text" id="content-slug" class="form-control" required>
                                <small style="color:#aaa;">مثال: introduction-to-forex</small>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>دسته‌بندی</label>
                            <select id="content-category" class="form-control" required>
                                <option value="basic">مبتدی (Basic)</option>
                                <option value="strategy">استراتژی (Strategy)</option>
                                <option value="technical">تحلیل تکنیکال (Technical)</option>
                                <option value="fundamental">تحلیل بنیادی (Fundamental)</option>
                            </select>
                        </div>
                    </div>

                    <!-- اطلاعات فارسی -->
                    <div class="language-section">
                        <div class="language-title">
                            <i class="fas fa-flag" style="color:#ffd700;"></i> اطلاعات فارسی
                        </div>
                        <div class="form-group">
                            <label>عنوان فارسی</label>
                            <input type="text" id="content-title-fa" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label>خلاصه (فارسی)</label>
                            <textarea id="content-excerpt-fa" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="form-group">
                            <label>محتوا (فارسی)</label>
                            <textarea id="content-body-fa" class="form-control" rows="5"></textarea>
                        </div>
                    </div>

                    <!-- اطلاعات انگلیسی -->
                    <div class="language-section">
                        <div class="language-title">
                            <i class="fas fa-flag" style="color:#ffd700;"></i> English Information
                        </div>
                        <div class="form-group">
                            <label>Title (English)</label>
                            <input type="text" id="content-title-en" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label>Excerpt (English)</label>
                            <textarea id="content-excerpt-en" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="form-group">
                            <label>Content (English)</label>
                            <textarea id="content-body-en" class="form-control" rows="5"></textarea>
                        </div>
                    </div>

                    <!-- اطلاعات عربی -->
                    <div class="language-section">
                        <div class="language-title">
                            <i class="fas fa-flag" style="color:#ffd700;"></i> المعلومات العربية
                        </div>
                        <div class="form-group">
                            <label>العنوان (عربي)</label>
                            <input type="text" id="content-title-ar" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label>الملخص (عربي)</label>
                            <textarea id="content-excerpt-ar" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="form-group">
                            <label>المحتوى (عربي)</label>
                            <textarea id="content-body-ar" class="form-control" rows="5"></textarea>
                        </div>
                    </div>

                    <!-- تنظیمات -->
                    <div class="row">
                        <div class="form-group">
                            <label>تصویر شاخص</label>
                            <input type="text" id="content-image" class="form-control" placeholder="آدرس تصویر">
                        </div>

                        <div class="form-group">
                            <label>ترتیب نمایش</label>
                            <input type="number" id="content-order" class="form-control" value="0">
                        </div>
                    </div>

                    <div style="display: flex; gap: 20px; margin: 20px 0;">
                        <label style="color:white;">
                            <input type="checkbox" id="content-isActive" checked> فعال
                        </label>
                    </div>

                    <div style="display: flex; gap: 10px; margin-top: 20px;">
                        <button type="submit" class="btn">ذخیره</button>
                        <button type="button" class="btn btn-danger" onclick="closeModal()">انصراف</button>
                    </div>
                </form>
            </div>
        </div>

        <script>
            // ============= بارگذاری لیست محتوا =============
            function loadContents() {
                fetch('/pprofessor/api/education')
                    .then(res => res.json())
                    .then(result => {
                        if (result.success) {
                            let html = '';
                            result.data.forEach(content => {
                                let categoryClass = '';
                                let categoryText = '';

                                switch (content.category) {
                                    case 'basic':
                                        categoryClass = 'category-basic';
                                        categoryText = 'مبتدی';
                                        break;
                                    case 'strategy':
                                        categoryClass = 'category-strategy';
                                        categoryText = 'استراتژی';
                                        break;
                                    case 'technical':
                                        categoryClass = 'category-technical';
                                        categoryText = 'تحلیل تکنیکال';
                                        break;
                                    case 'fundamental':
                                        categoryClass = 'category-fundamental';
                                        categoryText = 'تحلیل بنیادی';
                                        break;
                                }

                                html += `<tr>
                                <td>${content.title_fa || '-'}</td>
                                <td><code>${content.slug}</code></td>
                                <td><span class="category-badge ${categoryClass}">${categoryText}</span></td>
                                <td>${content.viewCount || 0}</td>
                                <td>${content.order || 0}</td>
                                <td>
                                    <span class="status-badge ${content.isActive ? 'status-active' : 'status-inactive'}" 
                                          onclick="toggleContentStatus(${content.id})" style="cursor:pointer;">
                                        ${content.isActive ? 'فعال' : 'غیرفعال'}
                                    </span>
                                </td>
                                <td>
                                    <button class="btn-icon" onclick="editContent(${content.id})"><i class="fas fa-edit"></i></button>
                                    <button class="btn-icon danger" onclick="deleteContent(${content.id})"><i class="fas fa-trash"></i></button>
                                </td>
                            </tr>`;
                            });
                            document.getElementById('contents-list').innerHTML = html;
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        document.getElementById('contents-list').innerHTML = '<tr><td colspan="7" style="text-align:center; color:#dc3545;">خطا در بارگذاری</td></tr>';
                    });
            }

            // ============= نمایش مودال ایجاد محتوا =============
            function showContentModal() {
                document.getElementById('modal-title').textContent = 'ایجاد محتوای جدید';
                document.getElementById('content-id').value = '';

                // پاک کردن فرم
                document.getElementById('content-title').value = '';
                document.getElementById('content-slug').value = '';
                document.getElementById('content-category').value = 'basic';
                document.getElementById('content-title-fa').value = '';
                document.getElementById('content-excerpt-fa').value = '';
                document.getElementById('content-body-fa').value = '';
                document.getElementById('content-title-en').value = '';
                document.getElementById('content-excerpt-en').value = '';
                document.getElementById('content-body-en').value = '';
                document.getElementById('content-title-ar').value = '';
                document.getElementById('content-excerpt-ar').value = '';
                document.getElementById('content-body-ar').value = '';
                document.getElementById('content-image').value = '';
                document.getElementById('content-order').value = '0';
                document.getElementById('content-isActive').checked = true;

                document.getElementById('content-modal').classList.add('active');
            }

            // ============= ویرایش محتوا =============
            function editContent(id) {
                fetch(`/pprofessor/api/education/${id}`)
                    .then(res => res.json())
                    .then(result => {
                        if (result.success) {
                            const content = result.data;
                            document.getElementById('modal-title').textContent = 'ویرایش محتوا';
                            document.getElementById('content-id').value = content.id;
                            document.getElementById('content-title').value = content.title_fa || '';
                            document.getElementById('content-slug').value = content.slug || '';
                            document.getElementById('content-category').value = content.category || 'basic';
                            document.getElementById('content-title-fa').value = content.title_fa || '';
                            document.getElementById('content-excerpt-fa').value = content.excerpt_fa || '';
                            document.getElementById('content-body-fa').value = content.content_fa || '';
                            document.getElementById('content-title-en').value = content.title_en || '';
                            document.getElementById('content-excerpt-en').value = content.excerpt_en || '';
                            document.getElementById('content-body-en').value = content.content_en || '';
                            document.getElementById('content-title-ar').value = content.title_ar || '';
                            document.getElementById('content-excerpt-ar').value = content.excerpt_ar || '';
                            document.getElementById('content-body-ar').value = content.content_ar || '';
                            document.getElementById('content-image').value = content.featuredImage || '';
                            document.getElementById('content-order').value = content.order || '0';
                            document.getElementById('content-isActive').checked = content.isActive;

                            document.getElementById('content-modal').classList.add('active');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showToast('خطا در دریافت اطلاعات', 'error');
                    });
            }

            // ============= ذخیره محتوا =============
            function saveContent() {
                const data = {
                    title_fa: document.getElementById('content-title-fa').value,
                    title_en: document.getElementById('content-title-en').value,
                    title_ar: document.getElementById('content-title-ar').value,
                    slug: document.getElementById('content-slug').value,
                    category: document.getElementById('content-category').value,
                    content_fa: document.getElementById('content-body-fa').value,
                    content_en: document.getElementById('content-body-en').value,
                    content_ar: document.getElementById('content-body-ar').value,
                    excerpt_fa: document.getElementById('content-excerpt-fa').value,
                    excerpt_en: document.getElementById('content-excerpt-en').value,
                    excerpt_ar: document.getElementById('content-excerpt-ar').value,
                    featuredImage: document.getElementById('content-image').value,
                    order: parseInt(document.getElementById('content-order').value) || 0,
                    isActive: document.getElementById('content-isActive').checked
                };

                const id = document.getElementById('content-id').value;
                const url = id ? `/pprofessor/api/education/${id}` : '/pprofessor/api/education';
                const method = id ? 'PUT' : 'POST';

                showToast('در حال ذخیره...', 'info');

                fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                })
                    .then(async res => {
                        const responseData = await res.json();
                        if (!res.ok) {
                            throw new Error(responseData.error || `خطا با کد ${res.status}`);
                        }
                        return responseData;
                    })
                    .then(result => {
                        if (result.success) {
                            showToast(id ? 'محتوا ویرایش شد' : 'محتوا ایجاد شد', 'success');
                            closeModal();
                            loadContents();
                        } else {
                            showToast('خطا: ' + (result.error || 'خطای ناشناخته'), 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Error details:', error);
                        showToast(error.message || 'خطا در ارتباط با سرور', 'error');
                    });
            }

            // ============= تغییر وضعیت محتوا =============
            function toggleContentStatus(id) {
                fetch(`/pprofessor/api/education/${id}/toggle`, { method: 'PATCH' })
                    .then(res => res.json())
                    .then(result => {
                        if (result.success) {
                            showToast('وضعیت تغییر کرد', 'success');
                            loadContents();
                        } else {
                            showToast('خطا: ' + result.error, 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showToast('خطا در ارتباط با سرور', 'error');
                    });
            }

            // ============= حذف محتوا =============
            function deleteContent(id) {
                if (confirm('آیا از حذف این محتوا اطمینان دارید؟')) {
                    fetch(`/pprofessor/api/education/${id}`, { method: 'DELETE' })
                        .then(res => res.json())
                        .then(result => {
                            if (result.success) {
                                showToast('محتوا حذف شد', 'success');
                                loadContents();
                            } else {
                                showToast('خطا: ' + result.error, 'error');
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            showToast('خطا در ارتباط با سرور', 'error');
                        });
                }
            }

            // ============= بستن مودال =============
            function closeModal() {
                document.getElementById('content-modal').classList.remove('active');
            }

            // ============= نمایش پیام =============
            function showToast(message, type = 'success') {
                const oldToast = document.getElementById('toast');
                if (oldToast) oldToast.remove();

                const toast = document.createElement('div');
                toast.id = 'toast';
                toast.textContent = message;
                toast.style.cssText = `
                position: fixed;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                padding: 15px 30px;
                border-radius: 10px;
                color: white;
                font-weight: bold;
                z-index: 9999;
                background: ${type === 'success' ? 'rgba(40, 167, 69, 0.9)' :
                        type === 'error' ? 'rgba(220, 53, 69, 0.9)' :
                            'rgba(23, 162, 184, 0.9)'};
                backdrop-filter: blur(10px);
                border: 1px solid ${type === 'success' ? '#28a745' :
                        type === 'error' ? '#dc3545' :
                            '#17a2b8'};
                box-shadow: 0 5px 20px rgba(0,0,0,0.3);
            `;
                document.body.appendChild(toast);

                setTimeout(() => toast.remove(), 3000);
            }

            // ============= بارگذاری اولیه =============
            document.addEventListener('DOMContentLoaded', loadContents);
        </script>
</body>

</html>