                                subtitle: { fa: 'بهترین بروکرها با رتبه‌بندی دقیق', en: 'Top Brokers with Accurate Ratings', ar: 'أفضل الوسطاء بتقييمات دقيقة' },
                                button: { fa: 'مشاهده بروکرها', en: 'View Brokers', ar: 'عرض الوسطاء' },
                                link: '/brokers'
                            },
                            {
                                image: 'https://images.unsplash.com/photo-1642790109470-24b3d1d6d2e2',
