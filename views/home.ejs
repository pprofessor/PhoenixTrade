<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ققنوس - آموزش فارکس، معرفی بروکرها و تحلیل بازار</title>
    <!-- TradingView Widget Script -->
    <script type="text/javascript" src="https://s3.tradingview.com/tv.js"></script>
    <!-- فونت سمیم -->
    <link rel="stylesheet" href="/css/fonts.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <!-- متا تگ‌های سئو -->
    <meta name="description"
        content="ققنوس - مرجع تخصصی آموزش فارکس، مقایسه و معرفی بروکرهای معتبر با رتبه‌بندی دقیق، تحلیل لحظه‌ای شاخص‌های بازار جهانی">
    <meta name="keywords" content="فارکس, بروکر, مقایسه بروکرها, آموزش فارکس, تحلیل بازار, طلا, نفت, شاخص‌های بورس">
    <meta name="author" content="PhoenixTrade">
    <meta property="og:title" content="ققنوس - آموزش و مقایسه بروکرها">
    <meta property="og:description" content="با ققنوس، بهترین بروکر را انتخاب کنید و حرفه‌ای معامله کنید">
    <meta property="og:type" content="website">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Samim', 'Vazir', 'Tahoma', sans-serif;
            background: linear-gradient(165deg, #0a3825 0%, #1a4f33 30%, #2e6b49 60%, #1a4f33 100%);
            min-height: 100vh;
            color: #ffffff;
            line-height: 1.5;
            position: relative;
            overflow-x: hidden;
        }

        body::before {
            content: '';
            position: fixed;
            top: -40%;
            left: -40%;
            width: 180%;
            height: 180%;
            background: radial-gradient(circle at 40% 40%,
                    rgba(255, 255, 255, 0.35) 0%,
                    rgba(100, 230, 170, 0.25) 25%,
                    rgba(40, 120, 80, 0.15) 50%,
                    transparent 80%);
            animation: jadeShimmer 18s ease-in-out infinite;
            pointer-events: none;
            z-index: 0;
        }

        .tradingview-widget-container {
            background: rgba(10, 40, 25, 0.3);
            border-radius: 12px;
            overflow: hidden;
            margin-top: 10px;
        }

        .index-item {
            background: rgba(10, 40, 25, 0.25);
            backdrop-filter: blur(15px) saturate(180%);
            border-radius: 20px;
            padding: 20px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            transition: all 0.3s;
        }

        .index-item:hover {
            transform: translateY(-5px);
            border-color: rgba(255, 215, 0, 0.4);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.4);
        }

        .index-symbol {
            font-size: 1.1rem;
            color: #ffd700;
            font-weight: bold;
        }

        @keyframes jadeShimmer {
            0% {
                transform: rotate(0deg) scale(1);
                opacity: 0.4;
            }

            25% {
                transform: rotate(3deg) scale(1.05);
                opacity: 0.8;
            }

            50% {
                transform: rotate(0deg) scale(1.1);
                opacity: 0.5;
            }

            75% {
                transform: rotate(-3deg) scale(1.05);
                opacity: 0.8;
            }

            100% {
                transform: rotate(0deg) scale(1);
                opacity: 0.4;
            }
        }

        .container {
            max-width: 1300px;
            margin: 0 auto;
            padding: 0 20px;
            position: relative;
            z-index: 10;
        }

        /* ===== هدر ===== */
        .header {
            position: sticky;
            top: 20px;
            z-index: 100;
            background: rgba(10, 40, 25, 0.25);
            backdrop-filter: blur(20px) saturate(180%);
            border-radius: 60px;
            margin: 20px auto;
            padding: 10px 30px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3),
                0 0 0 1px rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-icon {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, #ffd700, #b8860b);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            color: #0a3825;
            box-shadow: 0 0 25px rgba(255, 215, 0, 0.5);
        }

        .logo-text {
            font-size: 1.7rem;
            font-weight: bold;
            background: linear-gradient(135deg, #ffd700, #ffe68f);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-menu {
            display: flex;
            gap: 25px;
            list-style: none;
            flex-wrap: wrap;
        }

        .nav-menu a {
            text-decoration: none;
            color: #ffffff;
            font-weight: 500;
            transition: all 0.3s;
            padding: 8px 18px;
            border-radius: 40px;
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(5px);
            font-size: 0.95rem;
        }

        .nav-menu a:hover {
            background: rgba(255, 215, 0, 0.25);
            color: #ffd700;
            transform: translateY(-3px);
        }

        .header-actions {
            display: flex;
            gap: 15px;
            align-items: center;
            flex-wrap: wrap;
        }

        .lang-selector {
            display: flex;
            gap: 5px;
            background: rgba(0, 0, 0, 0.25);
            padding: 4px;
            border-radius: 40px;
        }

        .lang-btn {
            padding: 5px 12px;
            border: none;
            background: transparent;
            border-radius: 40px;
            cursor: pointer;
            font-size: 0.85rem;
            transition: all 0.3s;
            color: #ffffff;
        }

        .lang-btn.active {
            background: #ffd700;
            color: #0a3825;
        }

        .telegram-link {
            background: linear-gradient(135deg, #27a7e7, #0f7bc0);
            color: white;
            padding: 8px 20px;
            border-radius: 40px;
            text-decoration: none;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* ===== اسلایدشو ===== */
        .hero-slider {
            position: relative;
            margin: 40px 0 60px;
            border-radius: 40px;
            overflow: hidden;
            box-shadow: 0 30px 50px rgba(0, 0, 0, 0.4);
        }

        .slider-container {
            position: relative;
            width: 100%;
            height: 500px;
        }

        .slide {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            transition: opacity 0.8s ease-in-out;
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .slide.active {
            opacity: 1;
        }

        .slide-content {
            text-align: center;
            background: rgba(10, 40, 25, 0.4);
            backdrop-filter: blur(15px);
            padding: 40px;
            border-radius: 40px;
            max-width: 800px;
            margin: 0 20px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        }

        .slide-title {
            font-size: 2.8rem;
            margin-bottom: 15px;
            background: linear-gradient(135deg, #ffd700, #ffffff);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .slide-subtitle {
            font-size: 1.2rem;
            margin-bottom: 25px;
            color: rgba(255, 255, 255, 0.95);
        }

        .slider-dots {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 10px;
            z-index: 20;
        }

        .dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.5);
            cursor: pointer;
            transition: all 0.3s;
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .dot.active {
            background: #ffd700;
            transform: scale(1.3);
            box-shadow: 0 0 15px #ffd700;
        }

        .slider-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 40px;
            height: 40px;
            background: rgba(10, 40, 25, 0.4);
            backdrop-filter: blur(10px);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 20;
            color: #ffd700;
            font-size: 1.3rem;
            transition: all 0.3s;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .slider-arrow:hover {
            background: rgba(255, 215, 0, 0.3);
        }

        .slider-arrow.prev {
            left: 20px;
        }

        .slider-arrow.next {
            right: 20px;
        }

        /* ===== بخش‌های اصلی ===== */
        section {
            margin: 50px 0;
        }

        .section-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .section-title {
            font-size: 2.2rem;
            margin-bottom: 10px;
            color: #ffd700;
            text-shadow: 0 2px 15px rgba(255, 215, 0, 0.3);
        }

        .section-subtitle {
            font-size: 1.1rem;
            color: rgba(255, 255, 255, 0.8);
            max-width: 700px;
            margin: 0 auto;
        }

        .section-title::after {
            content: '';
            display: block;
            width: 80px;
            height: 3px;
            background: linear-gradient(90deg, transparent, #ffd700, transparent);
            margin: 15px auto 0;
        }

        /* ===== گرید بروکرها (۳ ستونه) ===== */
        .brokers-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin: 30px 0;
        }

        .broker-card {
            background: rgba(10, 40, 25, 0.25);
            backdrop-filter: blur(15px) saturate(180%);
            border-radius: 30px;
            padding: 25px;
            transition: all 0.3s;
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            display: flex;
            flex-direction: column;
        }

        .broker-card:hover {
            transform: translateY(-8px);
            border-color: rgba(255, 215, 0, 0.4);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
        }

        .broker-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 15px;
        }

        .broker-logo {
            width: 90px;
            height: 90px;
            background: linear-gradient(135deg, #ffd700, #b8860b);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            color: #0a3825;
            overflow: hidden;
            order: 2;
        }

        .broker-logo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .broker-name {
            font-size: 1.5rem;
            color: #ffd700;
            margin-bottom: 5px;
            order: 1;
        }

        .broker-rating {
            margin: 10px 0;
        }

        .stars {
            color: #ffd700;
            font-size: 1.1rem;
            margin-left: 5px;
        }

        .broker-features {
            margin: 15px 0;
            padding: 15px 0;
            border-top: 1px solid rgba(255, 215, 0, 0.1);
            border-bottom: 1px solid rgba(255, 215, 0, 0.1);
        }

        .feature-item {
            display: flex;
            justify-content: space-between;
            margin: 8px 0;
            font-size: 0.95rem;
        }

        .feature-label {
            color: #ffd700;
        }

        .regulators {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            justify-content: flex-end;
        }

        .regulator-badge {
            background: rgba(255, 215, 0, 0.1);
            border: 1px solid #ffd700;
            color: #ffd700;
            padding: 2px 8px;
            border-radius: 15px;
            font-size: 0.75rem;
            white-space: nowrap;
        }

        .broker-type {
            display: inline-block;
            background: rgba(255, 215, 0, 0.1);
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
            color: #ffd700;
        }

        .broker-actions {
            margin-top: auto;
        }

        .broker-btn {
            display: block;
            width: 100%;
            padding: 12px;
            background: linear-gradient(135deg, #ffd700, #b8860b);
            color: #0a3825;
            text-align: center;
            text-decoration: none;
            border-radius: 40px;
            font-weight: bold;
            transition: all 0.3s;
        }

        .broker-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(255, 215, 0, 0.3);
        }

        /* ===== گرید آموزش ===== */
        .education-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin: 30px 0;
        }

        .education-card {
            background: rgba(10, 40, 25, 0.25);
            backdrop-filter: blur(15px) saturate(180%);
            border-radius: 30px;
            padding: 25px;
            transition: all 0.3s;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .education-card:hover {
            transform: translateY(-8px);
            border-color: rgba(255, 215, 0, 0.4);
        }

        .education-card h3 {
            color: #ffd700;
            font-size: 1.3rem;
            margin-bottom: 15px;
        }

        .education-card p {
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 20px;
            font-size: 0.95rem;
        }

        .education-link {
            display: inline-block;
            padding: 8px 20px;
            background: rgba(255, 215, 0, 0.1);
            border: 1px solid #ffd700;
            color: #ffd700;
            text-decoration: none;
            border-radius: 40px;
            font-size: 0.9rem;
            transition: all 0.3s;
        }

        .education-link:hover {
            background: #ffd700;
            color: #0a3825;
        }

        /* ===== گرید شاخص‌های بازار ===== */
        .indices-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin: 30px 0;
        }

        .index-item {
            background: rgba(10, 40, 25, 0.25);
            backdrop-filter: blur(15px) saturate(180%);
            border-radius: 20px;
            padding: 20px;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .index-symbol {
            font-size: 1.1rem;
            color: #ffd700;
            margin-bottom: 8px;
        }

        .index-price {
            font-size: 1.6rem;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .index-change.positive {
            color: #28a745;
        }

        .index-change.negative {
            color: #dc3545;
        }

        .view-more-btn {
            display: inline-block;
            padding: 10px 25px;
            background: rgba(255, 215, 0, 0.1);
            border: 1px solid #ffd700;
            color: #ffd700;
            text-decoration: none;
            border-radius: 40px;
            margin-top: 20px;
            transition: all 0.3s;
        }

        .view-more-btn:hover {
            background: #ffd700;
            color: #0a3825;
        }

        /* ===== فوتر ===== */
        .footer {
            background: rgba(0, 20, 10, 0.35);
            backdrop-filter: blur(20px) saturate(180%);
            padding: 40px 0 20px;
            margin-top: 60px;
            border-top: 1px solid rgba(255, 255, 255, 0.15);
        }

        .footer-content {
            max-width: 600px;
            margin: 0 auto;
            text-align: center;
        }

        .footer-section {
            margin-bottom: 30px;
        }

        .footer-section h3 {
            color: #ffd700;
            margin-bottom: 20px;
            font-size: 1.2rem;
        }

        .contact-info {
            display: flex;
            flex-direction: column;
            gap: 15px;
            color: rgba(255, 255, 255, 0.8);
        }

        .contact-info a {
            color: #ffd700;
            text-decoration: none;
            transition: all 0.3s;
        }

        .contact-info a:hover {
            text-decoration: underline;
        }

        .awards {
            display: flex;
            gap: 20px;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 20px;
        }

        .award {
            width: 60px;
            height: 60px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            color: #ffd700;
            border: 1px solid rgba(255, 215, 0, 0.3);
            transition: all 0.3s;
        }

        .award:hover {
            transform: scale(1.1);
            border-color: #ffd700;
        }

        .copyright {
            text-align: center;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.9rem;
        }

        /* ===== ریسپانسیو ===== */
        @media (max-width: 1024px) {

            .brokers-grid,
            .education-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .indices-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {

            .brokers-grid,
            .education-grid,
            .indices-grid {
                grid-template-columns: 1fr;
            }

            .slide-title {
                font-size: 2rem;
            }
        }

        @media (max-width: 1200px) and (min-width: 1025px) {

            .brokers-grid,
            .education-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        .loading {
            text-align: center;
            padding: 50px;
        }

        .loading i {
            font-size: 2.5rem;
            color: #ffd700;
        }
    </style>
</head>

<body>
    <div class="container">
        <!-- ===== هدر ===== -->
        <header class="header" id="header-block">
            <div class="header-content">
                <div class="logo">
                    <div class="logo-icon">🦅</div>
                    <span class="logo-text" id="site-logo" data-fa="ققنوس" data-en="Phoenix"
                        data-ar="العنقاء">ققنوس</span>
                </div>

                <ul class="nav-menu" id="main-menu">
                    <li><a href="/" data-fa="صفحه اصلی" data-en="Home" data-ar="الرئيسية">صفحه اصلی</a></li>
                    <li><a href="/brokers" data-fa="بروکرها" data-en="Brokers" data-ar="الوسطاء">بروکرها</a></li>
                    <li><a href="/education" data-fa="آموزش" data-en="Education" data-ar="التعليم">آموزش</a></li>
                    <li><a href="/markets" data-fa="بازارها" data-en="Markets" data-ar="الأسواق">بازارها</a></li>
                </ul>

                <div class="header-actions">
                    <div class="lang-selector" id="language-selector">
                        <button class="lang-btn active" data-lang="fa">FA</button>
                        <button class="lang-btn" data-lang="en">EN</button>
                        <button class="lang-btn" data-lang="ar">AR</button>
                    </div>

                    <a href="https://t.me/PhoenixTradeBot" class="telegram-link" id="telegram-link" target="_blank">
                        <i class="fab fa-telegram-plane"></i>
                        <span data-fa="کانال تلگرام" data-en="Telegram" data-ar="تيليجرام">کانال تلگرام</span>
                    </a>
                </div>
            </div>
        </header>

        <!-- ===== اسلایدشو ===== -->
        <div class="hero-slider" id="hero-slider">
            <div class="slider-container" id="slider-container"></div>
            <div class="slider-dots" id="slider-dots"></div>
            <div class="slider-arrow prev" onclick="changeSlide(-1)">❮</div>
            <div class="slider-arrow next" onclick="changeSlide(1)">❯</div>
        </div>

        <!-- ===== بلوک بروکرها ===== -->
        <section id="brokers-section">
            <div class="section-header">
                <h2 class="section-title" data-fa="بروکرهای معتبر" data-en="Trusted Brokers" data-ar="وسطاء موثوقون">
                    بروکرهای معتبر</h2>
                <p class="section-subtitle" data-fa="مقایسه و انتخاب بهترین بروکر"
                    data-en="Compare and choose the best broker" data-ar="قارن واختر أفضل وسيط">مقایسه و انتخاب بهترین
                    بروکر</p>
            </div>

            <div class="brokers-grid" id="brokers-container">
                <div class="loading">
                    <i class="fas fa-spinner fa-spin"></i>
                </div>
            </div>
        </section>

        <!-- ===== بلوک آموزش ===== -->
        <section id="education-section">
            <div class="section-header">
                <h2 class="section-title" data-fa="آموزش" data-en="Education" data-ar="التعليم">آموزش</h2>
                <p class="section-subtitle" data-fa="از مفاهیم پایه تا استراتژی‌های پیشرفته"
                    data-en="From Basic to Advanced Strategies" data-ar="من الأساسيات إلى الاستراتيجيات المتقدمة">از
                    مفاهیم پایه تا استراتژی‌های پیشرفته</p>
            </div>

            <div class="education-grid" id="education-container">
                <div class="loading" style="grid-column: 1/-1;">
                    <i class="fas fa-spinner fa-spin"></i>
                </div>
            </div>

            <div style="text-align: center;">
                <a href="/education" class="view-more-btn" data-fa="مشاهده همه آموزش‌ها" data-en="View All Courses"
                    data-ar="عرض جميع الدورات">
                    مشاهده همه آموزش‌ها
                </a>
            </div>
        </section>

        <!-- ===== بلوک شاخص‌های لحظه‌ای ===== -->
