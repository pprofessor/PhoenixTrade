                            link: '/brokers'
                        },
                        {
                            image: 'https://images.unsplash.com/photo-1642790551116-18e150f248e7',
                            title: { fa: 'مقایسه و انتخاب بروکر', en: 'Compare & Choose Brokers', ar: 'مقارنة واختيار الوسيط' },
                            subtitle: { fa: 'بهترین بروکرها با رتبه‌بندی دقیق', en: 'Top Brokers with Accurate Ratings', ar: 'أفضل الوسطاء بتقييمات دقيقة' },
