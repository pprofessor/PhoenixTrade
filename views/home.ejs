                            subtitle: { fa: 'از مبتدی تا پیشرفته', en: 'From Beginner to Advanced', ar: 'من المبتدئ إلى المتقدم' },
                            button: { fa: 'دوره‌های آموزشی', en: 'Courses', ar: 'الدورات' },
                            link: '/education'
                        }
                    ];
                    renderSlides();
                });
        }

        function renderSlides() {
            const container = document.getElementById('slider-container');
            const dotsContainer = document.getElementById('slider-dots');
            const currentLang = document.querySelector('.lang-btn.active')?.dataset.lang || 'fa';

            let slidesHtml = '';
            let dotsHtml = '';

            slides.forEach((slide, index) => {
                slidesHtml += `
                    <div class="slide ${index === 0 ? 'active' : ''}" style="background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('${slide.image}');">
                        <div class="slide-content">
                            <h2 class="slide-title">${slide.title[currentLang]}</h2>
                            <p class="slide-subtitle">${slide.subtitle[currentLang]}</p>
                            <a href="${slide.link}" class="btn btn-primary" style="display:inline-block; padding:10px 30px; background:linear-gradient(135deg, #ffd700, #b8860b); color:#0a3825; border-radius:40px; text-decoration:none; font-weight:bold;">${slide.button[currentLang]}</a>
                        </div>
                    </div>
                `;
                dotsHtml += `<span class="dot ${index === 0 ? 'active' : ''}" onclick="goToSlide(${index})"></span>`;
            });

            container.innerHTML = slidesHtml;
            dotsContainer.innerHTML = dotsHtml;

            if (slideInterval) clearInterval(slideInterval);
            slideInterval = setInterval(() => changeSlide(1), 5000);
        }

        function showSlide(index) {
            const slides = document.querySelectorAll('.slide');
            const dots = document.querySelectorAll('.dot');
            if (index < 0) index = slides.length - 1;
            if (index >= slides.length) index = 0;
            slides.forEach(s => s.classList.remove('active'));
            dots.forEach(d => d.classList.remove('active'));
            slides[index].classList.add('active');
            dots[index].classList.add('active');
            currentSlide = index;
        }

        function changeSlide(direction) {
            showSlide(currentSlide + direction);
        }

        function goToSlide(index) {
            showSlide(index);
        }

        // ============= بارگذاری بروکرها =============
        function loadBrokers() {
            fetch('/api/brokers?limit=3')
                .then(res => res.json())
                .then(result => {
                    if (result.success) {
                        allBrokers = result.data;
                        displayBrokers(allBrokers);
                    }
                })
                .catch(error => console.error('Error loading brokers:', error));
        }

        function displayBrokers(brokers) {
            const container = document.getElementById('brokers-container');
            const currentLang = document.querySelector('.lang-btn.active')?.dataset.lang || 'fa';

            if (brokers.length === 0) {
                container.innerHTML = '<div style="grid-column:1/-1; text-align:center; padding:40px;">بروکری یافت نشد</div>';
                return;
            }

            let html = '';
            brokers.forEach(broker => {
                const stars = '★'.repeat(Math.floor(broker.rating)) + '☆'.repeat(5 - Math.floor(broker.rating));
                const regulations = JSON.parse(broker.regulations || '[]');
                const brokerTypes = ['ECN', 'STP', 'NDD', 'DMA', 'Cent'];
                const randomType = brokerTypes[Math.floor(Math.random() * brokerTypes.length)];

                html += `
                    <div class="broker-card">
                        <div class="broker-header">
                            <div class="broker-name">${broker.display_name_fa || broker.name}</div>
                            <div class="broker-logo">${broker.logo ? `<img src="${broker.logo}">` : '📊'}</div>
                        </div>
                        <div class="broker-rating"><span class="stars">${stars}</span> <span>(${broker.rating})</span></div>
                        <div class="broker-features">
                            <div class="feature-item"><span class="feature-label">سابقه:</span> <span>${broker.foundedYear || '-'}</span></div>
                            <div class="feature-item"><span class="feature-label">حداکثر لوریج:</span> <span>${broker.leverage || '۱:۱۰۰۰'}</span></div>
                            <div class="feature-item"><span class="feature-label">رگوله‌ها:</span> <div class="regulators">${regulations.slice(0, 2).map(r => `<span class="regulator-badge">${r}</span>`).join(' ')}${regulations.length > 2 ? `<span class="regulator-badge">+${regulations.length - 2}</span>` : ''}</div></div>
                            <div class="feature-item"><span class="feature-label">نوع بروکر:</span> <span class="broker-type">${randomType}</span></div>
                            <div class="feature-item"><span class="feature-label">حداقل واریز:</span> <span>${broker.minDeposit || '۱۰۰ دلار'}</span></div>
                        </div>
                        <div class="broker-actions"><a href="/brokers/${broker.slug}" class="broker-btn">مشاهده جزئیات و ثبت‌نام</a></div>
                    </div>
                `;
            });
            container.innerHTML = html;
        }

        // ============= بارگذاری آموزش =============
        function loadEducation() {
            fetch('/api/education?limit=3')
                .then(res => res.json())
                .then(result => {
                    if (result.success) {
                        allEducation = result.data;
                        displayEducation(allEducation);
                    }
                })
                .catch(error => console.error('Error loading education:', error));
        }

        function displayEducation(education) {
            const container = document.getElementById('education-container');
            const currentLang = document.querySelector('.lang-btn.active')?.dataset.lang || 'fa';

            if (education.length === 0) {
                container.innerHTML = '<div style="grid-column:1/-1; text-align:center; padding:40px;">محتوای آموزشی یافت نشد</div>';
                return;
            }

            let html = '';
            education.forEach(item => {
                html += `
                    <div class="education-card">
                        <h3>${item.title_fa}</h3>
                        <p>${item.excerpt_fa || 'برای مشاهده محتوا کلیک کنید'}</p>
                        <a href="/education/${item.slug}" class="education-link">ادامه مطلب</a>
                    </div>
                `;
            });
            container.innerHTML = html;
        }

        // ============= دریافت قیمت‌های لحظه‌ای از TradingView =============
        async function loadIndices() {
            const container = document.getElementById('indices-container');
            const currentLang = document.querySelector('.lang-btn.active')?.dataset.lang || 'fa';

            // شاخص‌های ثابت
            const indices = [
                {
                    symbol: 'FX:XAUUSD',
                    displaySymbol: 'XAUUSD',
                    name: { fa: 'انس جهانی طلا', en: 'Gold', ar: 'الذهب' },
                    icon: '🥇',
                    color: '#ffd700'
                },
                {
                    symbol: 'FX:XAGUSD',
                    displaySymbol: 'XAGUSD',
                    name: { fa: 'انس جهانی نقره', en: 'Silver', ar: 'الفضة' },
                    icon: '🥈',
                    color: '#c0c0c0'
                },
                {
                    symbol: 'TVC:USOIL',
                    displaySymbol: 'WTI',
                    name: { fa: 'نفت خام', en: 'Crude Oil', ar: 'النفط' },
                    icon: '🛢️',
                    color: '#8B4513'
                },
                {
                    symbol: 'TVC:NATGAS',
                    displaySymbol: 'NG',
                    name: { fa: 'گاز طبیعی', en: 'Natural Gas', ar: 'الغاز الطبيعي' },
                    icon: '🔥',
                    color: '#87CEEB'
                },
                {
                    symbol: 'TVC:CORN',
                    displaySymbol: 'CORN',
                    name: { fa: 'ذرت', en: 'Corn', ar: 'الذرة' },
                    icon: '🌽',
                    color: '#FFD700'
                },
                {
                    symbol: 'BITSTAMP:BTCUSD',
                    displaySymbol: 'BTCUSD',
                    name: { fa: 'بیت‌کوین', en: 'Bitcoin', ar: 'بتكوين' },
                    icon: '₿',
                    color: '#F7931A'
                }
            ];

            // نمایش لودینگ
            container.innerHTML = `
        <div style="grid-column:1/-1; text-align:center; padding:40px;">
            <i class="fas fa-spinner fa-spin" style="font-size: 2rem; color: #ffd700;"></i>
            <p style="margin-top: 20px;">در حال دریافت قیمت‌های لحظه‌ای...</p>
        </div>
    `;

            try {
                // دریافت قیمت‌ها از طریق یک پروکسی سرور (برای جلوگیری از CORS)
                const response = await fetch('/api/market-prices');
                const result = await response.json();

                if (result.success) {
                    displayIndices(indices, result.data, currentLang);
                } else {
                    throw new Error('خطا در دریافت قیمت‌ها');
                }
            } catch (error) {
                console.error('Error fetching prices:', error);
                // در صورت خطا، از داده‌های کش شده استفاده کن
                loadCachedPrices(indices, currentLang);
            }
        }

        function displayIndices(indices, prices, lang) {
            const container = document.getElementById('indices-container');

            let html = '';

            indices.forEach(item => {
                const priceData = prices[item.displaySymbol] || {
                    price: '---',
                    change: 0,
                    changePercent: 0
                };

                const changeValue = parseFloat(priceData.change) || 0;
                const changePercent = parseFloat(priceData.changePercent) || 0;
                const changeClass = changeValue >= 0 ? 'positive' : 'negative';
                const changeSign = changeValue >= 0 ? '+' : '';

                html += `
            <div class="index-item">
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
                    <span style="font-size: 2rem;">${item.icon}</span>
                    <div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="font-weight: bold; color: #ffd700;">${item.displaySymbol}</span>
                        </div>
                        <div style="font-size: 0.9rem; color: rgba(255,255,255,0.7);">
                            ${item.name[lang]}
                        </div>
                    </div>
                </div>
                
                <div style="margin-top: 15px;">
                    <div style="font-size: 2rem; font-weight: bold; color: white;">
                        ${priceData.price}
                    </div>
                    <div style="display: flex; align-items: center; gap: 10px; margin-top: 5px;">
                        <span style="font-size: 1rem; ${changeClass}">
                            ${changeSign}${changePercent.toFixed(1)}%
                        </span>
                        <span style="font-size: 0.8rem; color: rgba(255,255,255,0.5);">
                            ۲۴h تغییر
                        </span>
                    </div>
                </div>
            </div>
        `;
            });

            container.innerHTML = html;
        }

        function loadCachedPrices(indices, lang) {
            const container = document.getElementById('indices-container');

            // داده‌های کش شده از آخرین بروزرسانی
            const cachedPrices = JSON.parse(localStorage.getItem('marketPrices') || '{}');

            if (Object.keys(cachedPrices).length > 0) {
                displayIndices(indices, cachedPrices, lang);
            } else {
                // اگر هیچ داده‌ای وجود نداشت، از داده‌های پیش‌فرض استفاده کن
                const defaultPrices = {
                    'XAUUSD': { price: '۲٬۳۴۵٫۵۰', change: 0.8, changePercent: 0.8 },
                    'XAGUSD': { price: '۳۰٫۲۵', change: 1.2, changePercent: 1.2 },
                    'WTI': { price: '۷۸٫۳۲', change: -0.3, changePercent: -0.3 },
                    'NG': { price: '۲٫۱۵', change: 2.5, changePercent: 2.5 },
                    'CORN': { price: '۴۴۵٫۷۵', change: -0.5, changePercent: -0.5 },
                    'BTCUSD': { price: '۵۶٬۲۳۰', change: 2.1, changePercent: 2.1 }
                };
                displayIndices(indices, defaultPrices, lang);
            }
        }

        // تغییر زبان (به تابع changeLanguage اضافه کنید)
        function changeLanguage(lang) {
            document.querySelectorAll('[data-' + lang + ']').forEach(element => {
                const translation = element.getAttribute('data-' + lang);
                element.textContent = translation;
            });

            document.querySelectorAll('.lang-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            document.querySelector(`.lang-btn[data-lang="${lang}"]`).classList.add('active');

            // بارگذاری مجدد شاخص‌ها برای تغییر زبان
            loadIndices();
        }

        // در DOMContentLoaded، تابع loadIndices را فراخوانی کنید
        document.addEventListener('DOMContentLoaded', () => {
            loadSlides();
            loadBrokers();
            loadEducation();
            loadIndices();
            changeLanguage('fa');
        });

        // بارگذاری ویجت‌های TradingView
        setTimeout(() => {
            defaultIndices.forEach(index => {
                if (typeof TradingView !== 'undefined') {
                    new TradingView.widget({
                        "container_id": `tv-widget-${index.symbol}`,
                        "symbol": index.symbol === 'XAUUSD' ? 'FX:XAUUSD' :
                            index.symbol === 'XAGUSD' ? 'FX:XAGUSD' :
                                index.symbol === 'WTI' ? 'TVC:USOIL' :
                                    'BITSTAMP:BTCUSD',
                        "width": "100%",
                        "height": 100,
                        "locale": "fa",
                        "colorTheme": "dark",
                        "autosize": true,
                        "hide_legend": true,
                        "hide_side_toolbar": true,
                        "allow_symbol_change": false,
                        "details": false,
                        "hotlist": false,
                        "calendar": false,
                        "studies": [],
                        "theme": "dark",
                        "style": "1",
                        "timezone": "Asia/Tehran",
                        "withdateranges": false,
                        "hideideas": true,
                        "show_popup_button": false
                    });
                }
            });
        }, 100);


        // ============= تغییر زبان =============
        function changeLanguage(lang) {
            document.querySelectorAll('[data-' + lang + ']').forEach(element => {
                const translation = element.getAttribute('data-' + lang);
                element.textContent = translation;
            });
            document.querySelectorAll('.lang-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelector(`.lang-btn[data-lang="${lang}"]`).classList.add('active');
            renderSlides();
            displayBrokers(allBrokers);
            displayEducation(allEducation);
            displayIndices(featuredIndices);
        }

        document.querySelectorAll('.lang-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                changeLanguage(this.dataset.lang);
            });
        });

        document.addEventListener('DOMContentLoaded', () => {
            loadSlides();
            loadBrokers();
            loadEducation();
            loadFeaturedIndices();
            changeLanguage('fa');
        });
    </script>
