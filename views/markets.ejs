<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title data-fa="بازارهای مالی - PhoenixTrade" data-en="Financial Markets - PhoenixTrade"
        data-ar="الأسواق المالية - PhoenixTrade">بازارهای مالی - PhoenixTrade</title>
    <!-- فونت سمیم -->
    <link rel="stylesheet" href="/css/fonts.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Samim', 'Vazir', 'Tahoma', sans-serif;
            background: linear-gradient(165deg, #0a3825 0%, #1a4f33 30%, #2e6b49 60%, #1a4f33 100%);
            min-height: 100vh;
            color: #ffffff;
            line-height: 1.6;
            position: relative;
            overflow-x: hidden;
        }

        body::before {
            content: '';
            position: fixed;
            top: -40%;
            left: -40%;
            width: 180%;
            height: 180%;
            background: radial-gradient(circle at 40% 40%,
                    rgba(255, 255, 255, 0.35) 0%,
                    rgba(100, 230, 170, 0.25) 25%,
                    rgba(40, 120, 80, 0.15) 50%,
                    transparent 80%);
            animation: jadeShimmer 18s ease-in-out infinite;
            pointer-events: none;
            z-index: 0;
        }

        @keyframes jadeShimmer {
            0% {
                transform: rotate(0deg) scale(1);
                opacity: 0.4;
            }

            25% {
                transform: rotate(3deg) scale(1.05);
                opacity: 0.8;
            }

            50% {
                transform: rotate(0deg) scale(1.1);
                opacity: 0.5;
            }

            75% {
                transform: rotate(-3deg) scale(1.05);
                opacity: 0.8;
            }

            100% {
                transform: rotate(0deg) scale(1);
                opacity: 0.4;
            }
        }

        .container {
            max-width: 1300px;
            margin: 0 auto;
            padding: 0 20px;
            position: relative;
            z-index: 10;
        }

        .page-title {
            text-align: center;
            font-size: 2.5rem;
            color: #ffd700;
            margin: 50px 0 20px;
        }

        .page-subtitle {
            text-align: center;
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 50px;
            font-size: 1.1rem;
        }

        /* دسته‌بندی‌ها */
        .category-tabs {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 40px;
        }

        .category-tab {
            padding: 12px 30px;
            border: 1px solid rgba(255, 215, 0, 0.3);
            background: rgba(255, 255, 255, 0.05);
            border-radius: 40px;
            color: #fff;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 1rem;
        }

        .category-tab:hover,
        .category-tab.active {
            background: #ffd700;
            color: #0a3825;
            border-color: #ffd700;
        }

        /* گرید بازارها */
        .markets-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 25px;
            margin: 40px 0;
        }

        .market-card {
            background: rgba(10, 40, 25, 0.25);
            backdrop-filter: blur(15px) saturate(180%);
            border-radius: 30px;
            padding: 25px;
            transition: all 0.3s;
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        }

        .market-card:hover {
            transform: translateY(-10px);
            border-color: rgba(255, 215, 0, 0.4);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
        }

        .market-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .market-symbol {
            font-size: 1.3rem;
            font-weight: bold;
            color: #ffd700;
        }

        .market-type-badge {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            background: rgba(255, 215, 0, 0.15);
            color: #ffd700;
            border: 1px solid #ffd700;
        }

        .market-name {
            font-size: 1rem;
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 20px;
        }

        /* ویجت TradingView */
        .tradingview-widget-container {
            margin-top: 15px;
            border-radius: 15px;
            overflow: hidden;
            background: rgba(0, 0, 0, 0.3);
            min-height: 120px;
        }

        .no-data {
            text-align: center;
            padding: 50px;
            color: #aaa;
            background: rgba(10, 40, 25, 0.25);
            border-radius: 30px;
        }

        .loading {
            text-align: center;
            padding: 50px;
        }

        .loading i {
            font-size: 3rem;
            color: #ffd700;
        }

        @media (max-width: 768px) {
            .page-title {
                font-size: 2rem;
            }

            .markets-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>

    <script src="/js/i18n.js"></script>
</head>

<body>
    <div class="container">
        <!-- هدر -->
        <%- include('header') %>

            <!-- عنوان صفحه (سه‌زبانه) -->
            <h1 class="page-title" data-fa="بازارهای مالی" data-en="Financial Markets" data-ar="الأسواق المالية">
                بازارهای مالی</h1>
            <p class="page-subtitle" data-fa="قیمت‌های لحظه‌ای از TradingView" data-en="Live prices from TradingView"
                data-ar="أسعار مباشرة من TradingView">قیمت‌های لحظه‌ای از TradingView</p>

            <!-- دسته‌بندی‌ها (سه‌زبانه) -->
            <div class="category-tabs" id="category-tabs">
                <button class="category-tab active" data-type="all" data-fa="همه" data-en="All"
                    data-ar="الكل">همه</button>
                <button class="category-tab" data-type="forex" data-fa="فارکس" data-en="Forex"
                    data-ar="فوركس">فارکس</button>
                <button class="category-tab" data-type="commodity" data-fa="کالاها" data-en="Commodities"
                    data-ar="السلع">کالاها</button>
                <button class="category-tab" data-type="crypto" data-fa="ارز دیجیتال" data-en="Crypto"
                    data-ar="العملات الرقمية">ارز دیجیتال</button>
                <button class="category-tab" data-type="index" data-fa="شاخص‌ها" data-en="Indices"
                    data-ar="المؤشرات">شاخص‌ها</button>
                <button class="category-tab" data-type="stocks" data-fa="سهام" data-en="Stocks"
                    data-ar="الأسهم">سهام</button>
            </div>

            <!-- گرید بازارها -->
            <div id="markets-container">
                <div class="loading">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p style="margin-top: 20px;" data-fa="در حال بارگذاری بازارها..." data-en="Loading markets..."
                        data-ar="جاري تحميل الأسواق...">در حال بارگذاری بازارها...</p>
                </div>
            </div>
    </div>

    <!-- فوتر -->
    <%- include('footer') %>

        <!-- اسکریپت TradingView -->
        <script type="text/javascript" src="https://s3.tradingview.com/tv.js"></script>
        <script>
            // لیست نمادها بر اساس درخواست شما
            const symbols = {
                all: [
                    // فلزات
                    { symbol: 'COMEX:GC1!', name: { fa: 'طلای جهانی', en: 'Gold', ar: 'الذهب' }, icon: '🥇', type: 'commodity' },
                    { symbol: 'COMEX:SI1!', name: { fa: 'نقره', en: 'Silver', ar: 'الفضة' }, icon: '🥈', type: 'commodity' },

                    // انرژی
                    { symbol: 'NYMEX:NG1!', name: { fa: 'گاز طبیعی', en: 'Natural Gas', ar: 'الغاز الطبيعي' }, icon: '🔥', type: 'commodity' },
                    { symbol: 'NYMEX:CL1!', name: { fa: 'نفت وست تگزاس', en: 'WTI Crude Oil', ar: 'نفط غرب تكساس' }, icon: '🛢️', type: 'commodity' },
                    { symbol: 'TVC:UKOIL', name: { fa: 'نفت برنت', en: 'Brent Oil', ar: 'نفط برنت' }, icon: '🛢️', type: 'commodity' },

                    // فارکس
                    { symbol: 'FX:EURUSD', name: { fa: 'یورو به دلار', en: 'Euro to USD', ar: 'يورو إلى دولار' }, icon: '💶', type: 'forex' },
                    { symbol: 'FX:USDX', name: { fa: 'شاخص دلار', en: 'US Dollar Index', ar: 'مؤشر الدولار' }, icon: '📊', type: 'forex' },

                    // شاخص‌ها
                    { symbol: 'SP:SPX', name: { fa: 'شاخص S&P 500', en: 'S&P 500 Index', ar: 'مؤشر S&P 500' }, icon: '📈', type: 'index' },

                    // ارزهای دیجیتال
                    { symbol: 'BITSTAMP:BTCUSD', name: { fa: 'بیت‌کوین', en: 'Bitcoin', ar: 'بتكوين' }, icon: '₿', type: 'crypto' },
                    { symbol: 'BITSTAMP:ETHUSD', name: { fa: 'اتریوم', en: 'Ethereum', ar: 'إيثريوم' }, icon: '⟠', type: 'crypto' },
                    { symbol: 'BITSTAMP:TRXUSD', name: { fa: 'ترون', en: 'Tron', ar: 'ترون' }, icon: '🔷', type: 'crypto' },

                    // کالاهای کشاورزی
                    { symbol: 'CBOT:ZW1!', name: { fa: 'گندم', en: 'Wheat', ar: 'القمح' }, icon: '🌾', type: 'commodity' },
                    { symbol: 'CBOT:ZC1!', name: { fa: 'ذرت', en: 'Corn', ar: 'الذرة' }, icon: '🌽', type: 'commodity' },
                    { symbol: 'CBOT:ZS1!', name: { fa: 'سویا', en: 'Soybeans', ar: 'فول الصويا' }, icon: '🌱', type: 'commodity' },

                    // سهام
                    { symbol: 'NASDAQ:TSLA', name: { fa: 'تسلا', en: 'Tesla', ar: 'تسلا' }, icon: '⚡', type: 'stocks' },
                    { symbol: 'NASDAQ:AAPL', name: { fa: 'اپل', en: 'Apple', ar: 'آبل' }, icon: '🍎', type: 'stocks' }
                ],
                forex: [
                    { symbol: 'FX:EURUSD', name: { fa: 'یورو به دلار', en: 'Euro to USD', ar: 'يورو إلى دولار' }, icon: '💶', type: 'forex' },
                    { symbol: 'FX:USDX', name: { fa: 'شاخص دلار', en: 'US Dollar Index', ar: 'مؤشر الدولار' }, icon: '📊', type: 'forex' }
                ],
                commodity: [
                    { symbol: 'COMEX:GC1!', name: { fa: 'طلای جهانی', en: 'Gold', ar: 'الذهب' }, icon: '🥇', type: 'commodity' },
                    { symbol: 'COMEX:SI1!', name: { fa: 'نقره', en: 'Silver', ar: 'الفضة' }, icon: '🥈', type: 'commodity' },
                    { symbol: 'NYMEX:NG1!', name: { fa: 'گاز طبیعی', en: 'Natural Gas', ar: 'الغاز الطبيعي' }, icon: '🔥', type: 'commodity' },
                    { symbol: 'NYMEX:CL1!', name: { fa: 'نفت وست تگزاس', en: 'WTI Crude Oil', ar: 'نفط غرب تكساس' }, icon: '🛢️', type: 'commodity' },
                    { symbol: 'TVC:UKOIL', name: { fa: 'نفت برنت', en: 'Brent Oil', ar: 'نفط برنت' }, icon: '🛢️', type: 'commodity' },
                    { symbol: 'CBOT:ZW1!', name: { fa: 'گندم', en: 'Wheat', ar: 'القمح' }, icon: '🌾', type: 'commodity' },
                    { symbol: 'CBOT:ZC1!', name: { fa: 'ذرت', en: 'Corn', ar: 'الذرة' }, icon: '🌽', type: 'commodity' },
                    { symbol: 'CBOT:ZS1!', name: { fa: 'سویا', en: 'Soybeans', ar: 'فول الصويا' }, icon: '🌱', type: 'commodity' }
                ],
                crypto: [
                    { symbol: 'BITSTAMP:BTCUSD', name: { fa: 'بیت‌کوین', en: 'Bitcoin', ar: 'بتكوين' }, icon: '₿', type: 'crypto' },
                    { symbol: 'BITSTAMP:ETHUSD', name: { fa: 'اتریوم', en: 'Ethereum', ar: 'إيثريوم' }, icon: '⟠', type: 'crypto' },
                    { symbol: 'BITSTAMP:TRXUSD', name: { fa: 'ترون', en: 'Tron', ar: 'ترون' }, icon: '🔷', type: 'crypto' }
                ],
                index: [
                    { symbol: 'SP:SPX', name: { fa: 'شاخص S&P 500', en: 'S&P 500 Index', ar: 'مؤشر S&P 500' }, icon: '📈', type: 'index' }
                ],
                stocks: [
                    { symbol: 'NASDAQ:TSLA', name: { fa: 'تسلا', en: 'Tesla', ar: 'تسلا' }, icon: '⚡', type: 'stocks' },
                    { symbol: 'NASDAQ:AAPL', name: { fa: 'اپل', en: 'Apple', ar: 'آبل' }, icon: '🍎', type: 'stocks' }
                ]
            };

            let currentType = 'all';

            // گوش دادن به رویداد تغییر زبان
            document.addEventListener('languageChanged', function (e) {
                loadMarkets(currentType);
            });

            function loadMarkets(type) {
                const container = document.getElementById('markets-container');
                const selectedSymbols = symbols[type] || symbols.all;
                currentType = type;

                // دریافت زبان فعلی از i18n.js
                const currentLang = window.currentLang || 'fa';

                let html = '<div class="markets-grid">';

                selectedSymbols.forEach(item => {
                    // انتخاب نام بر اساس زبان
                    const name = item.name[currentLang] || item.name.fa;

                    // تعیین نوع برای نمایش
                    let typeText = '';
                    switch (item.type) {
                        case 'forex':
                            typeText = currentLang === 'fa' ? 'فارکس' : (currentLang === 'en' ? 'Forex' : 'فوركس');
                            break;
                        case 'commodity':
                            typeText = currentLang === 'fa' ? 'کالا' : (currentLang === 'en' ? 'Commodity' : 'سلعة');
                            break;
                        case 'crypto':
                            typeText = currentLang === 'fa' ? 'ارز دیجیتال' : (currentLang === 'en' ? 'Crypto' : 'عملة رقمية');
                            break;
                        case 'index':
                            typeText = currentLang === 'fa' ? 'شاخص' : (currentLang === 'en' ? 'Index' : 'مؤشر');
                            break;
                        case 'stocks':
                            typeText = currentLang === 'fa' ? 'سهام' : (currentLang === 'en' ? 'Stock' : 'سهم');
                            break;
                        default:
                            typeText = '';
                    }

                    html += `
                    <div class="market-card">
                        <div class="market-header">
                            <span class="market-symbol">${item.icon} ${item.symbol.split(':')[1] || item.symbol}</span>
                            <span class="market-type-badge">${typeText}</span>
                        </div>
                        <div class="market-name">${name}</div>
                        <div class="tradingview-widget-container">
                            <div class="tradingview-widget-container__widget" id="widget-${item.symbol.replace(/[:!]/g, '_')}"></div>
                        </div>
                    </div>
                `;
                });

                html += '</div>';
                container.innerHTML = html;

                // بارگذاری ویجت‌ها
                setTimeout(() => {
                    selectedSymbols.forEach(item => {
                        new TradingView.widget({
                            "container_id": `widget-${item.symbol.replace(/[:!]/g, '_')}`,
                            "symbol": item.symbol,
                            "width": "100%",
                            "height": 150,
                            "locale": currentLang === 'fa' ? 'fa' : (currentLang === 'ar' ? 'ar' : 'en'),
                            "colorTheme": "dark",
                            "autosize": true,
                            "hide_legend": true,
                            "hide_side_toolbar": true,
                            "allow_symbol_change": false,
                            "details": false,
                            "hotlist": false,
                            "calendar": false,
                            "studies": [],
                            "theme": "dark",
                            "style": "1",
                            "timezone": "Asia/Tehran",
                            "withdateranges": false,
                            "hideideas": true,
                            "show_popup_button": false,
                            "popup_width": "1000",
                            "popup_height": "650"
                        });
                    });
                }, 100);
            }

            // تغییر دسته‌بندی
            function changeCategory(type) {
                currentType = type;

                document.querySelectorAll('.category-tab').forEach(tab => {
                    tab.classList.remove('active');
                });
                document.querySelector(`[data-type="${type}"]`).classList.add('active');

                loadMarkets(type);
            }

            // رویداد کلیک دسته‌بندی‌ها
            document.querySelectorAll('.category-tab').forEach(tab => {
                tab.addEventListener('click', function () {
                    changeCategory(this.dataset.type);
                });
            });

            // بارگذاری اولیه
            document.addEventListener('DOMContentLoaded', () => {
                loadMarkets('all');
            });
        </script>
</body>

</html>