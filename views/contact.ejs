                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
    </div>

    <!-- ===== فوتر ===== -->
    <%- include('footer') %>

        <script>
            // ============= گوش دادن به رویداد تغییر زبان =============
            document.addEventListener('languageChanged', function (e) {
                // این تابع برای به‌روزرسانی احتمالی محتوای داینامیک در آینده استفاده می‌شود
                console.log('Language changed to:', e.detail.language);
            });

            // ============= رویداد کلیک دکمه‌های زبان در i18n.js مدیریت می‌شود =============
        </script>
</body>

</html>