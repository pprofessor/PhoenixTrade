<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title data-fa="ارتباط با ما - PhoenixTrade" data-en="Contact Us - PhoenixTrade" data-ar="اتصل بنا - PhoenixTrade">
        ارتباط با ما - PhoenixTrade</title>
    <!-- فونت سمیم -->
    <link rel="stylesheet" href="/css/fonts.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Samim', 'Vazir', 'Tahoma', sans-serif;
            background: linear-gradient(165deg, #0a3825 0%, #1a4f33 30%, #2e6b49 60%, #1a4f33 100%);
            min-height: 100vh;
            color: #ffffff;
            line-height: 1.6;
            position: relative;
            overflow-x: hidden;
        }

        body::before {
            content: '';
            position: fixed;
            top: -40%;
            left: -40%;
            width: 180%;
            height: 180%;
            background: radial-gradient(circle at 40% 40%,
                    rgba(255, 255, 255, 0.35) 0%,
                    rgba(100, 230, 170, 0.25) 25%,
                    rgba(40, 120, 80, 0.15) 50%,
                    transparent 80%);
            animation: jadeShimmer 18s ease-in-out infinite;
            pointer-events: none;
            z-index: 0;
        }

        @keyframes jadeShimmer {
            0% {
                transform: rotate(0deg) scale(1);
                opacity: 0.4;
            }

            25% {
                transform: rotate(3deg) scale(1.05);
                opacity: 0.8;
            }

            50% {
                transform: rotate(0deg) scale(1.1);
                opacity: 0.5;
            }

            75% {
                transform: rotate(-3deg) scale(1.05);
                opacity: 0.8;
            }

            100% {
                transform: rotate(0deg) scale(1);
                opacity: 0.4;
            }
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
            position: relative;
            z-index: 10;
        }

        /* ===== عنوان صفحه ===== */
        .page-header {
            text-align: center;
            margin: 50px 0 40px;
        }

        .page-title {
            font-size: 2.5rem;
            color: #ffd700;
            margin-bottom: 10px;
        }

        .page-subtitle {
            color: rgba(255, 255, 255, 0.8);
            font-size: 1.1rem;
        }

        /* ===== محتوای اصلی ===== */
        .contact-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            margin: 40px 0;
        }

        .contact-card {
            background: rgba(10, 40, 25, 0.25);
            backdrop-filter: blur(15px) saturate(180%);
            border-radius: 30px;
            padding: 40px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        }

        .card-title {
            color: #ffd700;
            font-size: 1.8rem;
            margin-bottom: 25px;
            border-bottom: 1px solid rgba(255, 215, 0, 0.3);
            padding-bottom: 15px;
        }

        /* ===== بخش سابقه شرکت ===== */
        .history-text {
            color: rgba(255, 255, 255, 0.9);
            line-height: 1.8;
            margin-bottom: 30px;
        }

        .history-text p {
            margin-bottom: 20px;
        }

        .history-highlight {
            display: inline-block;
            background: rgba(255, 215, 0, 0.1);
            border: 1px solid #ffd700;
            color: #ffd700;
            padding: 5px 15px;
            border-radius: 30px;
            font-size: 1rem;
            margin-bottom: 20px;
        }

        /* ===== اطلاعات تماس ===== */
        .contact-info {
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        .info-item {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 20px;
            background: rgba(0, 0, 0, 0.2);
            border-radius: 20px;
            transition: all 0.3s;
            border: 1px solid rgba(255, 215, 0, 0.1);
        }

        .info-item:hover {
            border-color: #ffd700;
            transform: translateY(-5px);
            background: rgba(0, 0, 0, 0.3);
        }

        .info-icon {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #ffd700, #b8860b);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            color: #0a3825;
        }

        .info-details {
            flex: 1;
        }

        .info-label {
            color: #ffd700;
            font-size: 1rem;
            margin-bottom: 5px;
        }

        .info-value {
            color: white;
            font-size: 1.2rem;
            font-weight: bold;
            word-break: break-all;
        }

        .info-link {
            color: white;
            text-decoration: none;
            transition: all 0.3s;
        }

        .info-link:hover {
            color: #ffd700;
        }

        @media (max-width: 768px) {
            .contact-content {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .page-title {
                font-size: 2rem;
            }

            .info-item {
                flex-direction: column;
                text-align: center;
            }
        }
    </style>

    <script src="/js/i18n.js"></script>
</head>

<body>
    <div class="container">
        <!-- ===== هدر ===== -->
        <%- include('header') %>

            <!-- ===== عنوان صفحه (سه‌زبانه) ===== -->
            <div class="page-header">
                <h1 class="page-title" data-fa="ارتباط با ما" data-en="Contact Us" data-ar="اتصل بنا">ارتباط با ما</h1>
                <p class="page-subtitle" data-fa="ما همیشه آماده پاسخگویی به سوالات شما هستیم"
                    data-en="We are always ready to answer your questions"
