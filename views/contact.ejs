                        <div class="award" title="تیم برتر تحلیل ۲۰۲۴" data-fa="تیم برتر تحلیل ۲۰۲۴"
                            data-en="Top Analysis Team 2024" data-ar="فريق التحليل المتميز ٢٠٢٤">⭐</div>
                        <div class="award" title="بیش از ۵۰۰۰ کاربر فعال" data-fa="بیش از ۵۰۰۰ کاربر فعال"
                            data-en="5000+ Active Users" data-ar="أكثر من ٥٠٠٠ مستخدم نشط">🌍</div>
                    </div>
                </div>

                <!-- بخش چپ - اطلاعات تماس (سه‌زبانه) -->
                <div class="contact-card">
                    <h2 class="card-title" data-fa="راه‌های ارتباطی" data-en="Contact Information"
                        data-ar="معلومات الاتصال">راه‌های ارتباطی</h2>

                    <div class="contact-info">
                        <!-- ایمیل -->
                        <div class="info-item">
