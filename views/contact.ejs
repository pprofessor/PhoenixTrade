            </div>

            <!-- ===== محتوای اصلی ===== -->
            <div class="contact-content">
                <!-- بخش راست - سابقه شرکت (سه‌زبانه) -->
                <div class="contact-card">
                    <h2 class="card-title" data-fa="درباره ققنوس" data-en="About Phoenix" data-ar="حول العنقاء">درباره
