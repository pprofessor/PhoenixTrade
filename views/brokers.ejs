<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title data-fa="لیست بروکرها - PhoenixTrade" data-en="Brokers List - PhoenixTrade"
        data-ar="قائمة الوسطاء - PhoenixTrade">لیست بروکرها - PhoenixTrade</title>
    <!-- فونت سمیم -->
    <link rel="stylesheet" href="/css/fonts.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Samim', 'Vazir', 'Tahoma', sans-serif;
            background: linear-gradient(165deg, #0a3825 0%, #1a4f33 30%, #2e6b49 60%, #1a4f33 100%);
            min-height: 100vh;
            color: #ffffff;
            line-height: 1.6;
            position: relative;
            overflow-x: hidden;
        }

        body::before {
            content: '';
            position: fixed;
            top: -40%;
            left: -40%;
            width: 180%;
            height: 180%;
            background: radial-gradient(circle at 40% 40%,
                    rgba(255, 255, 255, 0.35) 0%,
                    rgba(100, 230, 170, 0.25) 25%,
                    rgba(40, 120, 80, 0.15) 50%,
                    transparent 80%);
            animation: jadeShimmer 18s ease-in-out infinite;
            pointer-events: none;
            z-index: 0;
        }

        @keyframes jadeShimmer {
            0% {
                transform: rotate(0deg) scale(1);
                opacity: 0.4;
            }

            25% {
                transform: rotate(3deg) scale(1.05);
                opacity: 0.8;
            }

            50% {
                transform: rotate(0deg) scale(1.1);
                opacity: 0.5;
            }

            75% {
                transform: rotate(-3deg) scale(1.05);
                opacity: 0.8;
            }

            100% {
                transform: rotate(0deg) scale(1);
                opacity: 0.4;
            }
        }

        .container {
            max-width: 1300px;
            margin: 0 auto;
            padding: 0 20px;
            position: relative;
            z-index: 10;
        }

        .header {
            position: sticky;
            top: 20px;
            z-index: 100;
            background: rgba(10, 40, 25, 0.25);
            backdrop-filter: blur(20px) saturate(180%);
            border-radius: 60px;
            margin: 20px auto;
            padding: 12px 35px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3),
                0 0 0 1px rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-icon {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, #ffd700, #b8860b);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            color: #0a3825;
            box-shadow: 0 0 25px rgba(255, 215, 0, 0.5);
        }

        .logo-text {
            font-size: 1.7rem;
            font-weight: bold;
            background: linear-gradient(135deg, #ffd700, #ffe68f);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-menu {
            display: flex;
            gap: 25px;
            list-style: none;
            flex-wrap: wrap;
        }

        .nav-menu a {
            text-decoration: none;
            color: #ffffff;
            font-weight: 500;
            transition: all 0.3s;
            padding: 8px 18px;
            border-radius: 40px;
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(5px);
            font-size: 0.95rem;
        }

        .nav-menu a:hover {
            background: rgba(255, 215, 0, 0.25);
            color: #ffd700;
            transform: translateY(-3px);
        }

        .header-actions {
            display: flex;
            gap: 15px;
            align-items: center;
            flex-wrap: wrap;
        }

        .lang-selector {
            display: flex;
            gap: 5px;
            background: rgba(0, 0, 0, 0.25);
            padding: 4px;
            border-radius: 40px;
        }

        .lang-btn {
            padding: 5px 12px;
            border: none;
            background: transparent;
            border-radius: 40px;
            cursor: pointer;
            font-size: 0.85rem;
            transition: all 0.3s;
            color: #ffffff;
        }

        .lang-btn.active {
            background: #ffd700;
            color: #0a3825;
        }

        .telegram-link {
            background: linear-gradient(135deg, #27a7e7, #0f7bc0);
            color: white;
            padding: 8px 20px;
            border-radius: 40px;
            text-decoration: none;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .page-title {
            text-align: center;
            font-size: 2.5rem;
            color: #ffd700;
            margin: 50px 0 20px;
        }

        .page-subtitle {
            text-align: center;
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 50px;
            font-size: 1.1rem;
        }

        .filter-section {
            background: rgba(10, 40, 25, 0.25);
            backdrop-filter: blur(15px) saturate(180%);
            border-radius: 30px;
            padding: 30px;
            margin: 40px 0;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .search-box {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
        }

        .search-input {
            flex: 1;
            padding: 12px 20px;
            border-radius: 40px;
            border: 1px solid rgba(255, 215, 0, 0.3);
            background: rgba(0, 0, 0, 0.3);
            color: #fff;
            font-size: 1rem;
        }

        .search-input:focus {
            outline: none;
            border-color: #ffd700;
        }

        .filter-buttons {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .filter-btn {
            padding: 8px 20px;
            border: 1px solid rgba(255, 215, 0, 0.3);
            background: rgba(255, 255, 255, 0.05);
            border-radius: 40px;
            color: #fff;
            cursor: pointer;
            transition: all 0.3s;
        }

        .filter-btn:hover,
        .filter-btn.active {
            background: #ffd700;
            color: #0a3825;
            border-color: #ffd700;
        }

        .brokers-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 30px;
            margin: 40px 0;
        }

        .broker-card {
            background: rgba(10, 40, 25, 0.25);
            backdrop-filter: blur(15px) saturate(180%);
            border-radius: 30px;
            padding: 30px;
            transition: all 0.3s;
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        }

        .broker-card:hover {
            transform: translateY(-10px);
            border-color: rgba(255, 215, 0, 0.4);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
        }

        .broker-header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 20px;
        }

        .broker-logo {
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, #ffd700, #b8860b);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: #0a3825;
            overflow: hidden;
        }

        .broker-logo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .broker-info {
            flex: 1;
        }

        .broker-info h3 {
            color: #ffd700;
            font-size: 1.3rem;
            margin-bottom: 5px;
        }

        .broker-rating {
            display: flex;
            gap: 5px;
            align-items: center;
        }

        .stars {
            color: #ffd700;
        }

        .broker-features {
            margin: 20px 0;
            padding: 15px 0;
            border-top: 1px solid rgba(255, 215, 0, 0.1);
            border-bottom: 1px solid rgba(255, 215, 0, 0.1);
        }

        .broker-feature {
            display: flex;
            justify-content: space-between;
            margin: 8px 0;
            color: rgba(255, 255, 255, 0.8);
        }

        .feature-label {
            color: #ffd700;
        }

        .broker-actions {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .btn {
            flex: 1;
            padding: 10px 0;
            border: none;
            border-radius: 40px;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s;
            text-align: center;
            text-decoration: none;
        }

        .btn-primary {
            background: #ffd700;
            color: #0a3825;
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(255, 215, 0, 0.3);
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(5px);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-3px);
        }

        .compare-checkbox {
            display: flex;
            align-items: center;
            gap: 5px;
            margin-top: 10px;
            color: rgba(255, 255, 255, 0.8);
        }

        .compare-checkbox input[type="checkbox"] {
            accent-color: #ffd700;
        }

        .compare-bar {
            position: sticky;
            bottom: 20px;
            background: rgba(10, 40, 25, 0.9);
            backdrop-filter: blur(20px);
            border-radius: 60px;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid #ffd700;
            margin-top: 40px;
        }

        .loading {
            text-align: center;
            padding: 100px;
        }

        .loading i {
            font-size: 3rem;
            color: #ffd700;
        }

        .error-message {
            text-align: center;
            padding: 100px;
            color: #dc3545;
        }

        /* ===== فوتر (مثل صفحه اصلی) ===== */
        .footer {
            background: rgba(0, 20, 10, 0.35);
            backdrop-filter: blur(20px) saturate(180%);
            padding: 40px 0 20px;
            margin-top: 60px;
            border-top: 1px solid rgba(255, 255, 255, 0.15);
        }

        .footer-content {
            max-width: 600px;
            margin: 0 auto;
            text-align: center;
        }

        .footer-section {
            margin-bottom: 30px;
        }

        .footer-section h3 {
            color: #ffd700;
            margin-bottom: 20px;
            font-size: 1.2rem;
        }

        .contact-info {
            display: flex;
            flex-direction: column;
            gap: 15px;
            color: rgba(255, 255, 255, 0.8);
        }

        .contact-info a {
            color: #ffd700;
            text-decoration: none;
            transition: all 0.3s;
        }

        .contact-info a:hover {
            text-decoration: underline;
        }

        .awards {
            display: flex;
            gap: 20px;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 20px;
        }

        .award {
            width: 60px;
            height: 60px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            color: #ffd700;
            border: 1px solid rgba(255, 215, 0, 0.3);
            transition: all 0.3s;
        }

        .award:hover {
            transform: scale(1.1);
            border-color: #ffd700;
        }

        .copyright {
            text-align: center;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.9rem;
        }

        @media (max-width: 768px) {
            .footer-content {
                padding: 0 20px;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <!-- هدر (سه‌زبانه شده) -->
        <header class="header">
            <div class="header-content">
                <a href="/" style="text-decoration: none;">
                    <div class="logo">
                        <div class="logo-icon">🦅</div>
                        <span class="logo-text" data-fa="ققنوس" data-en="Phoenix" data-ar="العنقاء">ققنوس</span>
                    </div>
                </a>

                <ul class="nav-menu">
                    <li><a href="/" data-fa="صفحه اصلی" data-en="Home" data-ar="الرئيسية">صفحه اصلی</a></li>
                    <li><a href="/brokers" data-fa="بروکرها" data-en="Brokers" data-ar="الوسطاء">بروکرها</a></li>
                    <li><a href="/education" data-fa="آموزش" data-en="Education" data-ar="التعليم">آموزش</a></li>
                    <li><a href="/markets" data-fa="بازارها" data-en="Markets" data-ar="الأسواق">بازارها</a></li>
                </ul>

                <div class="header-actions">
                    <div class="lang-selector">
                        <button class="lang-btn active" data-lang="fa">FA</button>
                        <button class="lang-btn" data-lang="en">EN</button>
                        <button class="lang-btn" data-lang="ar">AR</button>
                    </div>

                    <a href="https://t.me/PhoenixTradeBot" class="telegram-link" target="_blank">
                        <i class="fab fa-telegram-plane"></i>
                        <span data-fa="کانال تلگرام" data-en="Telegram" data-ar="تيليجرام">کانال تلگرام</span>
                    </a>
                </div>
            </div>
        </header>

        <!-- عنوان صفحه (سه‌زبانه شده) -->
        <h1 class="page-title" data-fa="بروکرهای معتبر" data-en="Trusted Brokers" data-ar="وسطاء موثوقون">بروکرهای معتبر
        </h1>
        <p class="page-subtitle" data-fa="مقایسه و انتخاب بهترین بروکر برای معاملات شما"
            data-en="Compare and choose the best broker for your trades" data-ar="قارن واختر أفضل وسيط لصفقاتك">مقایسه و
            انتخاب بهترین بروکر برای معاملات شما</p>

        <!-- بخش فیلتر -->
        <div class="filter-section">
            <div class="search-box">
                <input type="text" id="search-input" class="search-input" placeholder="جستجوی بروکر...">
                <button class="btn btn-primary" onclick="searchBrokers()">جستجو</button>
            </div>

            <div class="filter-buttons">
                <button class="filter-btn active" onclick="filterBrokers('all')">همه</button>
                <button class="filter-btn" onclick="filterBrokers('featured')">بروکرهای ویژه</button>
                <button class="filter-btn" onclick="sortBrokers('rating')">بالاترین امتیاز</button>
                <button class="filter-btn" onclick="sortBrokers('order')">پیش‌فرض</button>
            </div>
        </div>

        <!-- لیست بروکرها -->
        <div id="brokers-container">
            <div class="loading">
                <i class="fas fa-spinner fa-spin"></i>
                <p style="margin-top: 20px;">در حال بارگذاری بروکرها...</p>
            </div>
        </div>

        <!-- نوار مقایسه -->
        <div class="compare-bar" id="compare-bar" style="display: none;">
            <span id="compare-count">۰ بروکر انتخاب شده</span>
            <a href="#" id="compare-link" class="btn btn-primary">مقایسه</a>
        </div>
    </div>

    <!-- فوتر (مثل صفحه اصلی) -->
    <%- include('footer') %>

    <script>
        let allBrokers = [];
        let selectedBrokers = [];
        let currentLang = 'fa';

        // ============= تابع تغییر زبان =============
        function changeLanguage(lang) {
            currentLang = lang;

            // تغییر متن المنت‌های دارای data-*
            document.querySelectorAll('[data-' + lang + ']').forEach(element => {
                const translation = element.getAttribute('data-' + lang);
                if (translation) element.textContent = translation;
            });

            // تغییر کلاس دکمه‌های زبان
            document.querySelectorAll('.lang-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            document.querySelector(`.lang-btn[data-lang="${lang}"]`).classList.add('active');

            // نمایش مجدد بروکرها با زبان جدید
            if (allBrokers.length > 0) {
                displayBrokers(allBrokers);
            }
        }

        // ============= بارگذاری بروکرها =============
        function loadBrokers() {
            fetch('/api/brokers')
                .then(res => res.json())
                .then(result => {
                    if (result.success) {
                        allBrokers = result.data;
                        displayBrokers(allBrokers);
                    } else {
                        showError();
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showError();
                });
        }

        function displayBrokers(brokers) {
            const container = document.getElementById('brokers-container');

            if (brokers.length === 0) {
                container.innerHTML = `
                    <div class="error-message">
                        <i class="fas fa-info-circle" style="font-size: 3rem;"></i>
                        <p style="margin-top: 20px;">هیچ بروکری یافت نشد</p>
                    </div>
                `;
                return;
            }

            let html = '<div class="brokers-grid">';

            brokers.forEach(broker => {
                const stars = '★'.repeat(Math.floor(broker.rating)) + '☆'.repeat(5 - Math.floor(broker.rating));
                const regulations = JSON.parse(broker.regulations || '[]');

                // انتخاب نام بروکر بر اساس زبان
                let brokerName = broker.display_name_fa || broker.name;
                if (currentLang === 'en' && broker.display_name_en) {
                    brokerName = broker.display_name_en;
                } else if (currentLang === 'ar' && broker.display_name_ar) {
                    brokerName = broker.display_name_ar;
                }

                html += `
                    <div class="broker-card">
                        <div class="broker-header">
                            <div class="broker-logo">
                                ${broker.logo ? `<img src="${broker.logo}">` : '📊'}
                            </div>
                            <div class="broker-info">
                                <h3>${brokerName}</h3>
                                <div class="broker-rating">
                                    <span class="stars">${stars}</span>
                                    <span>(${broker.rating})</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="broker-features">
                            <div class="broker-feature">
                                <span class="feature-label">${currentLang === 'fa' ? 'سال تأسیس' : currentLang === 'en' ? 'Founded' : 'تأسس'}:</span>
                                <span>${broker.foundedYear || '-'}</span>
                            </div>
                            <div class="broker-feature">
                                <span class="feature-label">${currentLang === 'fa' ? 'کاربران' : currentLang === 'en' ? 'Users' : 'المستخدمين'}:</span>
                                <span>${broker.usersCount || '۰'}</span>
                            </div>
                            <div class="broker-feature">
                                <span class="feature-label">${currentLang === 'fa' ? 'اسپرد' : currentLang === 'en' ? 'Spread' : 'السبريد'}:</span>
                                <span>${broker.spread || '-'}</span>
                            </div>
                            <div class="broker-feature">
                                <span class="feature-label">${currentLang === 'fa' ? 'اهرم' : currentLang === 'en' ? 'Leverage' : 'الرافعة'}:</span>
                                <span>${broker.leverage || '-'}</span>
                            </div>
                        </div>
                        
                        <div class="broker-actions">
                            <a href="/brokers/${broker.slug}" class="btn btn-secondary">${currentLang === 'fa' ? 'جزئیات' : currentLang === 'en' ? 'Details' : 'التفاصيل'}</a>
                            <a href="${broker.registerLink || '#'}" class="btn btn-primary" target="_blank">${currentLang === 'fa' ? 'ثبت‌نام' : currentLang === 'en' ? 'Register' : 'تسجيل'}</a>
                        </div>
                        
                        <div class="compare-checkbox">
                            <input type="checkbox" value="${broker.id}" onchange="toggleCompare(${broker.id}, this.checked)">
                            <label>${currentLang === 'fa' ? 'انتخاب برای مقایسه' : currentLang === 'en' ? 'Select to compare' : 'اختر للمقارنة'}</label>
                        </div>
                    </div>
                `;
            });

            html += '</div>';
            container.innerHTML = html;
        }

        function toggleCompare(id, checked) {
            if (checked) {
                if (selectedBrokers.length < 4) {
                    selectedBrokers.push(id);
                } else {
                    alert(currentLang === 'fa' ? 'حداکثر می‌توانید ۴ بروکر را مقایسه کنید' :
                        currentLang === 'en' ? 'You can compare up to 4 brokers' :
                            'يمكنك مقارنة حتى ٤ وسطاء');
                    event.target.checked = false;
                    return;
                }
            } else {
                selectedBrokers = selectedBrokers.filter(b => b !== id);
            }

            updateCompareBar();
        }

        function updateCompareBar() {
            const bar = document.getElementById('compare-bar');
            const countSpan = document.getElementById('compare-count');
            const link = document.getElementById('compare-link');

            if (selectedBrokers.length > 0) {
                countSpan.textContent = currentLang === 'fa' ? `${selectedBrokers.length} بروکر انتخاب شده` :
                    currentLang === 'en' ? `${selectedBrokers.length} brokers selected` :
                        `${selectedBrokers.length} وسطاء مختارون`;
                link.href = `/compare?ids=${selectedBrokers.join(',')}`;
                bar.style.display = 'flex';
            } else {
                bar.style.display = 'none';
            }
        }

        function searchBrokers() {
            const query = document.getElementById('search-input').value.toLowerCase();
            const filtered = allBrokers.filter(b => {
                const nameFa = (b.display_name_fa || b.name).toLowerCase();
                const nameEn = (b.display_name_en || '').toLowerCase();
                const nameAr = (b.display_name_ar || '').toLowerCase();
                return nameFa.includes(query) || nameEn.includes(query) || nameAr.includes(query) || b.name.toLowerCase().includes(query);
            });
            displayBrokers(filtered);
        }

        function filterBrokers(type) {
            document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');

            if (type === 'all') {
                displayBrokers(allBrokers);
            } else if (type === 'featured') {
                const filtered = allBrokers.filter(b => b.isFeatured);
                displayBrokers(filtered);
            }
        }

        function sortBrokers(type) {
            document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');

            let sorted = [...allBrokers];
            if (type === 'rating') {
                sorted.sort((a, b) => b.rating - a.rating);
            } else if (type === 'order') {
                sorted.sort((a, b) => (a.order || 0) - (b.order || 0));
            }

            displayBrokers(sorted);
        }

        function showError() {
            document.getElementById('brokers-container').innerHTML = `
                <div class="error-message">
                    <i class="fas fa-exclamation-triangle" style="font-size: 3rem;"></i>
                    <p style="margin-top: 20px;">${currentLang === 'fa' ? 'خطا در بارگذاری بروکرها' :
                    currentLang === 'en' ? 'Error loading brokers' :
                        'خطأ في تحميل الوسطاء'}</p>
                </div>
            `;
        }

        // ============= رویدادهای زبان =============
        document.querySelectorAll('.lang-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                changeLanguage(this.dataset.lang);
            });
        });

        document.addEventListener('DOMContentLoaded', () => {
            loadBrokers();
            changeLanguage('fa');
        });
    </script>
</body>

</html>