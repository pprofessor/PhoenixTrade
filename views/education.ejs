<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title data-fa="<%= title || 'محتوای آموزشی' %> - PhoenixTrade"
        data-en="<%= title || 'Educational Content' %> - PhoenixTrade"
        data-ar="<%= title || 'محتوى تعليمي' %> - PhoenixTrade">
        <%= title || 'محتوای آموزشی' %> - PhoenixTrade
    </title>
    <!-- فونت سمیم -->
    <link rel="stylesheet" href="/css/fonts.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Samim', 'Vazir', 'Tahoma', sans-serif;
            background: linear-gradient(165deg, #0a3825 0%, #1a4f33 30%, #2e6b49 60%, #1a4f33 100%);
            min-height: 100vh;
            color: #ffffff;
            line-height: 1.6;
            position: relative;
            overflow-x: hidden;
        }

        body::before {
            content: '';
            position: fixed;
            top: -40%;
            left: -40%;
            width: 180%;
            height: 180%;
            background: radial-gradient(circle at 40% 40%,
                    rgba(255, 255, 255, 0.35) 0%,
                    rgba(100, 230, 170, 0.25) 25%,
                    rgba(40, 120, 80, 0.15) 50%,
                    transparent 80%);
            animation: jadeShimmer 18s ease-in-out infinite;
            pointer-events: none;
            z-index: 0;
        }

        @keyframes jadeShimmer {
            0% {
                transform: rotate(0deg) scale(1);
                opacity: 0.4;
            }

            25% {
                transform: rotate(3deg) scale(1.05);
                opacity: 0.8;
            }

            50% {
                transform: rotate(0deg) scale(1.1);
                opacity: 0.5;
            }

            75% {
                transform: rotate(-3deg) scale(1.05);
                opacity: 0.8;
            }

            100% {
                transform: rotate(0deg) scale(1);
                opacity: 0.4;
            }
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
            position: relative;
            z-index: 10;
        }

        /* محتوای اصلی */
        .content-wrapper {
            background: rgba(10, 40, 25, 0.25);
            backdrop-filter: blur(15px) saturate(180%);
            border-radius: 40px;
            padding: 50px;
            margin: 40px 0;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .content-header {
            margin-bottom: 30px;
            border-bottom: 1px solid rgba(255, 215, 0, 0.3);
            padding-bottom: 20px;
        }

        .content-title {
            font-size: 2.5rem;
            color: #ffd700;
            margin-bottom: 15px;
        }

        .content-meta {
            display: flex;
            gap: 20px;
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.9rem;
            flex-wrap: wrap;
        }

        .content-meta i {
            color: #ffd700;
            margin-left: 5px;
        }

        .category-badge {
            display: inline-block;
            padding: 5px 15px;
            border-radius: 30px;
            font-size: 0.9rem;
            background: rgba(255, 215, 0, 0.15);
            color: #ffd700;
            border: 1px solid #ffd700;
        }

        .featured-image {
            width: 100%;
            max-height: 400px;
            object-fit: cover;
            border-radius: 20px;
            margin: 30px 0;
            border: 1px solid rgba(255, 215, 0, 0.3);
        }

        .content-body {
            font-size: 1.1rem;
            line-height: 1.8;
            color: rgba(255, 255, 255, 0.9);
        }

        .content-body h2 {
            color: #ffd700;
            margin: 30px 0 15px;
        }

        .content-body p {
            margin-bottom: 20px;
        }

        .content-body ul,
        .content-body ol {
            margin: 20px 0;
            padding-right: 40px;
        }

        .content-body li {
            margin-bottom: 10px;
        }

        .back-link {
            display: inline-block;
            margin-bottom: 20px;
            color: #ffd700;
            text-decoration: none;
            font-size: 1rem;
        }

        .back-link i {
            margin-left: 5px;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        .loading {
            text-align: center;
            padding: 100px;
        }

        .loading i {
            font-size: 3rem;
            color: #ffd700;
        }

        .error-message {
            text-align: center;
            padding: 100px;
            color: #dc3545;
        }

        @media (max-width: 768px) {
            .content-title {
                font-size: 1.8rem;
            }

            .content-wrapper {
                padding: 30px;
            }
        }
    </style>

    <script src="/js/i18n.js"></script>
</head>

<body>
    <div class="container">
        <!-- هدر -->
        <%- include('header') %>

            <!-- محتوای اصلی -->
            <div class="content-wrapper" id="content-container">
                <div class="loading">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p style="margin-top: 20px;" data-fa="در حال بارگذاری..." data-en="Loading..."
                        data-ar="جاري التحميل...">در حال بارگذاری...</p>
                </div>
            </div>

            <!-- دکمه بازگشت (سه‌زبانه) -->
            <a href="/education" class="back-link" data-fa="بازگشت به لیست آموزش‌ها" data-en="Back to Education List"
                data-ar="العودة إلى قائمة التعليم">
                <i class="fas fa-arrow-right"></i> بازگشت به لیست آموزش‌ها
            </a>
    </div>

    <!-- فوتر -->
    <%- include('footer') %>

        <script>
            // دریافت slug از URL
            const pathParts = window.location.pathname.split('/');
            const slug = pathParts[pathParts.length - 1];
            let currentContent = null;

            // ============= بارگذاری محتوا =============
            async function loadContent() {
                try {
                    const response = await fetch(`/api/education/${slug}`);
                    const result = await response.json();

                    if (result.success) {
                        currentContent = result.data;
                        displayContent(currentContent);
                    } else {
                        showError();
                    }
                } catch (error) {
                    console.error('Error:', error);
                    showError();
                }
            }

            // ============= نمایش محتوا =============
            function displayContent(content) {
                const container = document.getElementById('content-container');
                const currentLang = window.currentLang || 'fa';

                let categoryText = '';
                let categoryEn = '';
                let categoryAr = '';

                switch (content.category) {
                    case 'basic':
                        categoryText = 'مبتدی';
                        categoryEn = 'Beginner';
                        categoryAr = 'مبتدئ';
                        break;
                    case 'strategy':
                        categoryText = 'استراتژی';
                        categoryEn = 'Strategy';
                        categoryAr = 'استراتيجية';
                        break;
                    case 'technical':
                        categoryText = 'تحلیل تکنیکال';
                        categoryEn = 'Technical Analysis';
                        categoryAr = 'تحليل فني';
                        break;
                    case 'fundamental':
                        categoryText = 'تحلیل بنیادی';
                        categoryEn = 'Fundamental Analysis';
                        categoryAr = 'تحليل أساسي';
                        break;
                    default:
                        categoryText = content.category;
                        categoryEn = content.category;
                        categoryAr = content.category;
                }

                // انتخاب عنوان بر اساس زبان
                let title = content.title_fa;
                if (currentLang === 'en' && content.title_en) {
                    title = content.title_en;
                } else if (currentLang === 'ar' && content.title_ar) {
                    title = content.title_ar;
                }

                // انتخاب محتوا بر اساس زبان
                let contentBody = content.content_fa || '';
                if (currentLang === 'en' && content.content_en) {
                    contentBody = content.content_en;
                } else if (currentLang === 'ar' && content.content_ar) {
                    contentBody = content.content_ar;
                }

                // انتخاب دسته‌بندی بر اساس زبان
                let displayCategory = categoryText;
                if (currentLang === 'en') {
                    displayCategory = categoryEn;
                } else if (currentLang === 'ar') {
                    displayCategory = categoryAr;
                }

                const date = new Date(content.createdAt).toLocaleDateString(
                    currentLang === 'fa' ? 'fa-IR' :
                        currentLang === 'en' ? 'en-US' :
                            'ar-SA'
                );

                const viewText = currentLang === 'fa' ? 'بازدید' :
                    currentLang === 'en' ? 'views' :
                        'مشاهدة';

                container.innerHTML = `
                <div class="content-header">
                    <h1 class="content-title">${title}</h1>
                    <div class="content-meta">
                        <span><i class="fas fa-calendar"></i> ${date}</span>
                        <span><i class="fas fa-eye"></i> ${content.viewCount || 0} ${viewText}</span>
                        <span><i class="fas fa-tag"></i> <span class="category-badge">${displayCategory}</span></span>
                    </div>
                </div>
                
                ${content.featuredImage ?
                        `<img src="${content.featuredImage}" alt="${title}" class="featured-image">` :
                        ''}
                
                <div class="content-body">
                    ${contentBody || (currentLang === 'fa' ? 'محتوایی وجود ندارد' :
                        currentLang === 'en' ? 'No content available' :
                            'لا يوجد محتوى')}
                </div>
            `;
            }

            // ============= نمایش خطا =============
            function showError() {
                const container = document.getElementById('content-container');
                const currentLang = window.currentLang || 'fa';

                const errorMsg = currentLang === 'fa' ? 'محتوا یافت نشد' :
                    currentLang === 'en' ? 'Content not found' :
                        'المحتوى غير موجود';

                const backText = currentLang === 'fa' ? 'بازگشت به لیست آموزش‌ها' :
                    currentLang === 'en' ? 'Back to Education List' :
                        'العودة إلى قائمة التعليم';

                container.innerHTML = `
                <div class="error-message">
                    <i class="fas fa-exclamation-triangle" style="font-size: 3rem;"></i>
                    <p style="margin-top: 20px;">${errorMsg}</p>
                    <a href="/education" style="
                        display: inline-block;
                        margin-top: 20px;
                        padding: 10px 30px;
                        background: #ffd700;
                        color: #0a3825;
                        text-decoration: none;
                        border-radius: 30px;
                    ">${backText}</a>
                </div>
            `;
            }

            // ============= گوش دادن به رویداد تغییر زبان =============
            document.addEventListener('languageChanged', function (e) {
                if (currentContent) {
                    displayContent(currentContent);
                }
            });

            // ============= بارگذاری اولیه =============
            document.addEventListener('DOMContentLoaded', () => {
                loadContent();
            });
        </script>
</body>

</html>